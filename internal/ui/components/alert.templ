package components

templ Alert(kind, message string) { <div role={ toastRole(kind) } class={ "flex items-start gap-3 rounded-box border bg-base-200 p-4 text-sm text-base-content shadow-theme " + alertTone(kind) }>{ message }</div> }

func alertTone(kind string) string { switch kind { case "success": return "border-success/30 bg-success/10"; case "error", "danger": return "border-error/30 bg-error/10"; case "warning": return "border-warning/30 bg-warning/10"; default: return "border-info/30 bg-info/10" } }
