package components

import (
	"strings"
	"github.com/shepard-labs/cyclopus/internal/avatar"
	"github.com/shepard-labs/cyclopus/internal/store"
)

templ Sidebar(org store.Organization, user store.User, currentPath string) {
	<nav class="sidebar">
		<div class="p-4 border-b border-base-300">
			<div class="flex items-center gap-2 mb-1">
				<wa-icon name="circle-info" class="w-6 h-6 text-primary" aria-hidden="true"></wa-icon>
				<span class="font-semibold text-base-content">Cyclopus</span>
			</div>
			<div class="text-xs text-base-content/50 truncate pl-8">{ org.Name }</div>
		</div>
		<div class="flex-1 overflow-y-auto p-2 space-y-1">
			<a
				href="/projects"
				class={ sidebarItemClass(currentPath, "/projects") }
			>
				<wa-icon name="table-cells-large" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				Projects
			</a>
			<div class="pt-4 pb-1 px-3">
				<span class="text-xs font-medium text-base-content/35 uppercase tracking-wide">Settings</span>
			</div>
			<a href="/settings/git-connections" class={ sidebarItemClass(currentPath, "/settings/git-connections") }>
				<wa-icon name="code-branch" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				Git Connections
			</a>
			<a href="/settings/registries" class={ sidebarItemClass(currentPath, "/settings/registries") }>
				<wa-icon name="box" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				Registries
			</a>
			<a href="/settings/webhooks" class={ sidebarItemClass(currentPath, "/settings/webhooks") }>
				<wa-icon name="plug" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				Webhooks
			</a>
			<a href="/settings/tokens" class={ sidebarItemClass(currentPath, "/settings/tokens") }>
				<wa-icon name="key" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				API Tokens
			</a>
			<a href="/settings/audit" class={ sidebarItemClass(currentPath, "/settings/audit") }>
				<wa-icon name="list" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				Audit Log
			</a>
			<div class="pt-4 pb-1 px-3">
				<span class="text-xs font-medium text-base-content/35 uppercase tracking-wide">Admin</span>
			</div>
			<a href="/admin/reconcile" class={ sidebarItemClass(currentPath, "/admin/reconcile") }>
				<wa-icon name="rotate" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
				Reconcile
			</a>
		</div>
		<div class="p-2 border-t border-base-300">
			<div class="sidebar-account-shell">
			<wa-dropdown placement="top-start" class="sidebar-account">
				<wa-button slot="trigger" appearance="plain" class="sidebar-item sidebar-account-trigger">
					<span class="sidebar-account-trigger-content">
						<img class="sidebar-account-avatar" src={ avatar.URL(user.AvatarKey) } alt=""/>
						<span class="truncate text-xs">{ userAccountName(user) }</span>
						<wa-icon name="chevron-up" class="sidebar-account-chevron" aria-hidden="true"></wa-icon>
					</span>
				</wa-button>
				<div class="sidebar-account-label">
					<p class="sidebar-account-label-title">Account</p>
					<p class="sidebar-account-email">{ user.Email }</p>
				</div>
				<wa-divider></wa-divider>
				<wa-dropdown-item value="user-settings">
					<a href="/settings/user" class="account-menu-link" onclick="event.stopPropagation()">
						<wa-icon name="gear" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
						User Settings
					</a>
				</wa-dropdown-item>
				<wa-dropdown-item value="theme">
					<a href="/settings/theme" class="account-menu-link" onclick="event.stopPropagation()">
						<wa-icon name="palette" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
						Theme
					</a>
				</wa-dropdown-item>
				<wa-dropdown-item value="logout" variant="danger">
					<wa-icon name="right-from-bracket" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
					Sign out
				</wa-dropdown-item>
			</wa-dropdown>
			<form method="POST" action="/logout" hx-boost="false" class="logout" hidden></form>
			<script>
				customElements.whenDefined('wa-dropdown').then(function () {
					var menu = document.querySelector('.sidebar-account')
					if (!menu || menu.dataset.bound) { return }
					menu.dataset.bound = 'true'
					menu.addEventListener('wa-select', function (event) {
						var value = event.detail.item.value
						if (value === 'user-settings') { window.location.assign('/settings/user') }
						if (value === 'theme') { window.location.assign('/settings/theme') }
						if (value === 'logout') { menu.closest('nav').querySelector('form.logout').requestSubmit() }
					})
				})
			</script>
			</div>
		</div>
	</nav>
}

func userAccountName(user store.User) string {
	if name := strings.TrimSpace(user.DisplayName); name != "" {
		return name
	}
	if name := strings.TrimSpace(user.FirstName + " " + user.LastName); name != "" {
		return name
	}
	return user.Email
}

func sidebarItemClass(currentPath, prefix string) string {
	base := "sidebar-item"
	if len(currentPath) >= len(prefix) && currentPath[:len(prefix)] == prefix {
		return base + " active"
	}
	return base
}
