package components

import (
	"strings"
	"github.com/shepard-labs/cyclopus/internal/avatar"
	"github.com/shepard-labs/cyclopus/internal/store"
)

templ Sidebar(org store.Organization, user store.User, currentPath string) {
	<nav class="sidebar">
		<div class="p-4 border-b border-base-300">
			<div class="flex items-center gap-2 mb-1">
				<svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="12" y1="8" x2="12" y2="12"></line>
					<line x1="12" y1="16" x2="12.01" y2="16"></line>
				</svg>
				<span class="font-semibold text-base-content">Cyclopus</span>
			</div>
			<div class="text-xs text-base-content/50 truncate pl-8">{ org.Name }</div>
		</div>
		<div class="flex-1 overflow-y-auto p-2 space-y-1">
			<a
				href="/projects"
				class={ sidebarItemClass(currentPath, "/projects") }
			>
				@iconGrid()
				Projects
			</a>
			<div class="pt-4 pb-1 px-3">
				<span class="text-xs font-medium text-base-content/35 uppercase tracking-wide">Settings</span>
			</div>
			<a href="/settings/git-connections" class={ sidebarItemClass(currentPath, "/settings/git-connections") }>
				@iconGit()
				Git Connections
			</a>
			<a href="/settings/registries" class={ sidebarItemClass(currentPath, "/settings/registries") }>
				@iconBox()
				Registries
			</a>
			<a href="/settings/webhooks" class={ sidebarItemClass(currentPath, "/settings/webhooks") }>
				@iconWebhook()
				Webhooks
			</a>
			<a href="/settings/tokens" class={ sidebarItemClass(currentPath, "/settings/tokens") }>
				@iconKey()
				API Tokens
			</a>
			<a href="/settings/audit" class={ sidebarItemClass(currentPath, "/settings/audit") }>
				@iconList()
				Audit Log
			</a>
			<div class="pt-4 pb-1 px-3">
				<span class="text-xs font-medium text-base-content/35 uppercase tracking-wide">Admin</span>
			</div>
			<a href="/admin/reconcile" class={ sidebarItemClass(currentPath, "/admin/reconcile") }>
				@iconRefresh()
				Reconcile
			</a>
		</div>
		<div class="p-2 border-t border-base-300">
			<details class="sidebar-account" onclick="event.stopPropagation()">
				<summary class="sidebar-item sidebar-account-trigger">
					<img class="sidebar-account-avatar" src={ avatar.URL(user.AvatarKey) } alt=""/>
					<span class="truncate text-xs">{ userAccountName(user) }</span>
					@iconChevronUp()
				</summary>
				<div class="sidebar-account-menu">
					<div class="sidebar-account-label">
						<p class="sidebar-account-label-title">Account</p>
						<p class="sidebar-account-email">{ user.Email }</p>
					</div>
					<div class="sidebar-account-separator"></div>
					<a href="/settings/user" class="sidebar-account-action">
						@iconSettings()
						User Settings
					</a>
					<form method="POST" action="/logout" hx-boost="false">
						<button type="submit" class="sidebar-account-action">
							@iconLogout()
							Sign out
						</button>
					</form>
				</div>
			</details>
			<script>
				document.addEventListener('click', function () {
					document.querySelectorAll('.sidebar-account[open]').forEach(function (menu) { menu.removeAttribute('open') })
				})
			</script>
		</div>
	</nav>
}

func userAccountName(user store.User) string {
	if name := strings.TrimSpace(user.DisplayName); name != "" {
		return name
	}
	if name := strings.TrimSpace(user.FirstName + " " + user.LastName); name != "" {
		return name
	}
	return user.Email
}

func sidebarItemClass(currentPath, prefix string) string {
	base := "sidebar-item"
	if len(currentPath) >= len(prefix) && currentPath[:len(prefix)] == prefix {
		return base + " active"
	}
	return base
}

templ iconGrid() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect>
		<rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
	</svg>
}

templ iconGit() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle>
		<path d="M6 9v6"></path><path d="M18 9a9 9 0 0 0-9 9"></path>
	</svg>
}

templ iconBox() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
	</svg>
}

templ iconWebhook() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
	</svg>
}

templ iconKey() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path d="M15 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"></path>
		<path d="M2 17l4-4 2 2 3-3 2 2a10 10 0 0 0 7-10"></path>
	</svg>
}

templ iconList() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line>
		<line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line>
	</svg>
}

templ iconRefresh() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline>
		<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
	</svg>
}

templ iconUser() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
	</svg>
}

templ iconChevronUp() {
	<svg class="sidebar-account-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<polyline points="18 15 12 9 6 15"></polyline>
	</svg>
}

templ iconLogout() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
		<polyline points="16 17 21 12 16 7"></polyline>
		<line x1="21" y1="12" x2="9" y2="12"></line>
	</svg>
}

templ iconSettings() {
	<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<circle cx="12" cy="12" r="3"></circle>
		<path d="M19 12a7 7 0 0 1-.2 1.7l2 1.6-2 3.4-2.5-1a7 7 0 0 1-2.9 1.7L13 22H9l-.4-2.6a7 7 0 0 1-2.9-1.7l-2.5 1-2-3.4 2-1.6A7 7 0 0 1 3 12c0-.6.1-1.2.2-1.7l-2-1.6 2-3.4 2.5 1a7 7 0 0 1 2.9-1.7L9 2h4l.4 2.6a7 7 0 0 1 2.9 1.7l2.5-1 2 3.4-2 1.6c.1.5.2 1.1.2 1.7Z"></path>
	</svg>
}
