package components

import "github.com/shepard-labs/cyclopus/internal/ui"

templ Flash(f *ui.FlashMessage) {
	if f != nil {
		switch f.Kind {
			case "success":
				<div class="toast alert alert-success" role="status" aria-live="polite">
					<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
					<span>{ f.Message }</span>
					<button type="button" class="toast-close" aria-label="Dismiss notification" onclick="this.parentElement.remove()">@iconClose()</button>
				</div>
			case "error":
				<div class="toast alert alert-error" role="alert" aria-live="assertive">
					<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
					<span>{ f.Message }</span>
					<button type="button" class="toast-close" aria-label="Dismiss notification" onclick="this.parentElement.remove()">@iconClose()</button>
				</div>
			default:
				<div class="toast alert alert-info" role="status" aria-live="polite">
					<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
					<span>{ f.Message }</span>
					<button type="button" class="toast-close" aria-label="Dismiss notification" onclick="this.parentElement.remove()">@iconClose()</button>
				</div>
		}
	}
}

templ iconClose() {
	<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		<line x1="18" y1="6" x2="6" y2="18"></line>
		<line x1="6" y1="6" x2="18" y2="18"></line>
	</svg>
}
