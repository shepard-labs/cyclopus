package components

import "github.com/shepard-labs/cyclopus/internal/ui"

templ Flash(f *ui.FlashMessage) {
	if f != nil {
		<div id="flash-region" class="fixed top-4 right-4 z-50" aria-live="polite">@Toast("flash-message", f.Kind, f.Message)</div>
		<script>setTimeout(function(){var n=document.getElementById('flash-message');if(n){n.dataset.leaving='true';setTimeout(function(){n.remove()},300)}},5000)</script>
	}
}
