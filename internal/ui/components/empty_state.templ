package components

templ EmptyState(title, description string) { <div class="rounded-box border border-dashed border-base-content/20 bg-base-100 px-6 py-12 text-center"><div class="mx-auto flex size-10 items-center justify-center rounded-full bg-base-200">@IconSquares("size-5 text-base-content/50")</div><h3 class="mt-4 text-sm font-semibold">{ title }</h3><p class="mt-1 text-sm text-base-content/60">{ description }</p><div class="mt-5">{ children... }</div></div> }
