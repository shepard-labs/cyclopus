package components

// CommandPalette children are command options. Each option must provide
// data-command-value; data-command-text is the caller-observable label and
// falls back to trimmed option text when omitted.
templ CommandPalette(triggerID, dialogID, title string) {
	<div data-command-palette>
		<button id={ triggerID } type="button" command="show-modal" commandfor={ dialogID } aria-controls={ dialogID } class="inline-flex items-center gap-2 rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium">@IconMagnifyingGlass("size-4")<span>{ title }</span></button>
		@Dialog(dialogID, title) {
			<div role="search" class="flex items-center gap-2 border-b border-line pb-3">
				@IconMagnifyingGlass("size-5 text-base-content/50")
				<input id={ dialogID + "-input" } type="search" role="combobox" aria-label="Search commands" aria-autocomplete="list" aria-controls={ dialogID + "-listbox" } aria-expanded="false" autocomplete="off" class="w-full bg-transparent text-sm outline-none focus-visible:ring-2 focus-visible:ring-base-content focus-visible:ring-offset-2 focus-visible:ring-offset-base-300" placeholder="Type a command…"/>
			</div>
			<div id={ dialogID + "-listbox" } class="mt-2" role="listbox">{ children... }</div>
			<input id={ dialogID + "-value" } type="hidden" data-command-value-output/>
			<output id={ dialogID + "-output" } aria-live="polite" class="sr-only" data-command-text-output></output>
		}
		<script>
			(function () {
				var root = document.currentScript.parentElement;
				var trigger = root.querySelector('[aria-controls]');
				var dialog = root.querySelector('dialog');
				var input = root.querySelector('[role="combobox"]');
				var listbox = root.querySelector('[role="listbox"]');
				var valueOutput = root.querySelector('[data-command-value-output]');
				var textOutput = root.querySelector('[data-command-text-output]');
				var options = Array.prototype.slice.call(listbox.querySelectorAll('[data-command-value]'));
				var active = -1;

				options.forEach(function (option, index) {
					if (!option.dataset.commandText) option.dataset.commandText = option.textContent.trim();
					option.setAttribute('role', 'option');
					if (!option.id) option.id = listbox.id + '-option-' + index;
					option.setAttribute('aria-selected', 'false');
				});

				function visibleOptions() {
					return options.filter(function (option) { return !option.hidden; });
				}

				function setActive(index) {
					var visible = visibleOptions();
					options.forEach(function (option) { option.setAttribute('aria-selected', 'false'); });
					if (!visible.length) {
						active = -1;
						input.removeAttribute('aria-activedescendant');
						return;
					}
					active = (index + visible.length) % visible.length;
					visible[active].setAttribute('aria-selected', 'true');
					input.setAttribute('aria-activedescendant', visible[active].id);
					visible[active].scrollIntoView({ block: 'nearest' });
				}

				function filter() {
					var query = input.value.trim().toLowerCase();
					options.forEach(function (option) {
						option.hidden = option.dataset.commandText.toLowerCase().indexOf(query) === -1;
					});
					setActive(0);
				}

				function close() {
					input.setAttribute('aria-expanded', 'false');
					if (dialog.open) dialog.close();
					trigger.focus();
				}

				function select(option) {
					var label = option.dataset.commandText;
					input.value = label;
					valueOutput.value = option.dataset.commandValue;
					textOutput.value = label;
					textOutput.textContent = label;
					valueOutput.dispatchEvent(new Event('input', { bubbles: true }));
					valueOutput.dispatchEvent(new Event('change', { bubbles: true }));
					root.dispatchEvent(new CustomEvent('commandselect', { bubbles: true, detail: { value: valueOutput.value, text: label } }));
					close();
				}

				dialog.addEventListener('toggle', function () {
					if (!dialog.open) return;
					input.setAttribute('aria-expanded', 'true');
					input.value = '';
					filter();
					input.focus();
				});
				input.addEventListener('input', filter);
				input.addEventListener('keydown', function (event) {
					if (event.key === 'ArrowDown') { event.preventDefault(); setActive(active + 1); }
					else if (event.key === 'ArrowUp') { event.preventDefault(); setActive(active - 1); }
					else if (event.key === 'Enter') {
						var visible = visibleOptions();
						if (active >= 0 && visible[active]) { event.preventDefault(); select(visible[active]); }
					}
				});
				options.forEach(function (option) { option.addEventListener('click', function () { select(option); }); });
				dialog.addEventListener('close', function () { input.setAttribute('aria-expanded', 'false'); });
			})();
		</script>
	</div>
}
