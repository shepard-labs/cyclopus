package components

templ Popover(triggerID, panelID, label string) {
	<button id={ triggerID } type="button" popovertarget={ panelID } aria-controls={ panelID } class="rounded-field px-3 py-2 text-sm font-medium hover:bg-base-300">{ label }</button>
	<el-popover id={ panelID } popover anchor={ triggerID } class="rounded-box border border-line bg-base-300 p-4 text-sm shadow-theme transition-discrete data-closed:opacity-0">{ children... }</el-popover>
}
