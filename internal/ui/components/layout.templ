package components

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
)

// Page renders the full-page shell with sidebar, topbar, content area, and flash.
// content is rendered inside the main area. extraCSS lists page-specific
// stylesheets (under /static/css/pages/) to link after the shared ui.css.
templ Page(title string, user store.User, org store.Organization, flash *ui.FlashMessage, currentPath string, content templ.Component, extraCSS ...string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cyclopus</title>
			<!-- theme.js loads synchronously before the stylesheet: it applies the
			     persisted preset to <html> so the first paint uses the right theme. -->
			<script src="/static/theme.js"></script>
			<!-- Web Awesome base theme BEFORE our stylesheet so our unlayered token
			     overrides win the cascade. Autoloader is async (deferred module). -->
			<link rel="stylesheet" href="/static/vendor/webawesome/styles/themes/default.css"/>
			<link rel="stylesheet" href="/static/css/ui.css"/>
			for _, href := range extraCSS {
				<link rel="stylesheet" href={ href }/>
			}
			<script type="module" src="/static/vendor/webawesome/webawesome.loader.js"></script>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="h-full flex bg-base-100 text-base-content" hx-boost="true">
			@Sidebar(org, user, currentPath)
			<div class="flex-1 flex flex-col ml-64 min-w-0">
				<header class="topbar">
					<span class="text-sm text-base-content/65">{ title }</span>
				</header>
				<main class="flex-1 overflow-y-auto p-6">
					if flash != nil {
						@Flash(flash)
					}
					@content
				</main>
			</div>
		</body>
	</html>
}

// AuthPage renders a minimal centered page for login / bootstrap (no sidebar).
templ AuthPage(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cyclopus</title>
			<!-- synchronous, before the stylesheet — see Page above. -->
			<script src="/static/theme.js"></script>
			<link rel="stylesheet" href="/static/vendor/webawesome/styles/themes/default.css"/>
			<link rel="stylesheet" href="/static/css/ui.css"/>
			<script type="module" src="/static/vendor/webawesome/webawesome.loader.js"></script>
		</head>
		<body class="h-full flex items-center justify-center bg-base-100 text-base-content">
			{ children... }
		</body>
	</html>
}
