package components

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
)

// Page renders the full-page shell with sidebar, topbar, content area, and flash.
templ Page(title string, user store.User, org store.Organization, flash *ui.FlashMessage, currentPath string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cyclopus</title>
			<script src="/static/theme.js"></script>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script type="module" src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1"></script>
		</head>
		<body class="min-h-full bg-base-100 font-sans text-base-content antialiased" hx-boost="true">
			@Sidebar(org, user, currentPath)
			<div class="min-w-0 lg:pl-56">
				<header class="sticky top-0 z-30 flex h-14 items-center border-b border-line bg-base-200 px-4 sm:px-6 lg:px-8">
					@MobileNavTrigger()
					<span class="text-sm font-medium text-base-content/70">{ title }</span>
				</header>
				<main class="p-4 sm:p-6 lg:p-8">
					if flash != nil {
						@Flash(flash)
					}
					@content
				</main>
			</div>
		</body>
	</html>
}

// AuthPage renders a minimal centered page for login / bootstrap (no sidebar).
templ AuthPage(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cyclopus</title>
			<script src="/static/theme.js"></script>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script type="module" src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1"></script>
		</head>
		<body class="flex min-h-full items-center justify-center bg-base-100 p-6 font-sans text-base-content antialiased">
			{ children... }
		</body>
	</html>
}
