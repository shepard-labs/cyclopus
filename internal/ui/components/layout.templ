package components

import "github.com/cyclopus-dev/cyclopus/internal/ui"

// Page renders the full-page shell with sidebar, topbar, content area, and flash.
// content is rendered inside the main area.
templ Page(title string, user ui.User, org ui.Organization, flash *ui.FlashMessage, currentPath string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cyclopus</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="h-full flex bg-zinc-950 text-zinc-100" hx-boost="true">
			@Sidebar(org, user, currentPath)
			<div class="flex-1 flex flex-col ml-64 min-w-0">
				<header class="topbar">
					<span class="text-sm text-zinc-400">{ title }</span>
					<div class="flex items-center gap-3">
						<span class="text-xs text-zinc-500">{ user.Email }</span>
						<form method="POST" action="/logout" hx-boost="false">
							<button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
						</form>
					</div>
				</header>
				<main class="flex-1 overflow-y-auto p-6">
					if flash != nil {
						@Flash(flash)
					}
					@content
				</main>
			</div>
		</body>
	</html>
}

// AuthPage renders a minimal centered page for login / bootstrap (no sidebar).
templ AuthPage(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cyclopus</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="h-full flex items-center justify-center bg-zinc-950 text-zinc-100">
			{ children... }
		</body>
	</html>
}
