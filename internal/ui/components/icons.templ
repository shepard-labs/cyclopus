package components

// Icon renders the shared outline Heroicon SVG frame. Callers provide a path
// component from the helpers below so icons remain inline and inherit color.
templ Icon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-slot="icon">
		{ children... }
	</svg>
}

templ IconLogo(class string) { @Icon(class) { <circle cx="12" cy="12" r="9"/><path d="M12 8.25v4.5m0 3h.008v.008H12v-.008Z" stroke-linecap="round"/> } }
templ IconSquares(class string) { @Icon(class) { <path d="M3.75 3.75h6.5v6.5h-6.5v-6.5Zm10 0h6.5v6.5h-6.5v-6.5Zm-10 10h6.5v6.5h-6.5v-6.5Zm10 0h6.5v6.5h-6.5v-6.5Z"/> } }
templ IconCodeBranch(class string) { @Icon(class) { <circle cx="6" cy="5" r="2.25"/><circle cx="18" cy="19" r="2.25"/><circle cx="6" cy="19" r="2.25"/><path d="M6 7.25v9.5m2.25 2.25h3.5A6.25 6.25 0 0 0 18 12.75v-5.5"/> } }
templ IconCube(class string) { @Icon(class) { <path d="m12 2.75 8.25 4.5v9.5L12 21.25l-8.25-4.5v-9.5L12 2.75Z"/><path d="m3.75 7.25 8.25 4.5 8.25-4.5M12 11.75v9.5"/> } }
templ IconBolt(class string) { @Icon(class) { <path d="M13.5 2.25 4.75 13h6l-.25 8.75L19.25 11h-6l.25-8.75Z" stroke-linejoin="round"/> } }
templ IconKey(class string) { @Icon(class) { <circle cx="15.75" cy="8.25" r="4.5"/><path d="m12.5 11.5-8.75 8.75m2.5-2.5 2 2m.75-4.75 2 2"/> } }
templ IconList(class string) { @Icon(class) { <path d="M8.25 6.75h12m-12 5.25h12m-12 5.25h12M3.75 6.75h.008v.008H3.75V6.75Zm0 5.25h.008v.008H3.75V12Zm0 5.25h.008v.008H3.75v-.008Z" stroke-linecap="round"/> } }
templ IconArrowPath(class string) { @Icon(class) { <path d="M16.023 9.348h4.992V4.356m-1.93 10.732a8.25 8.25 0 1 1-.164-6.57l2.094.83M7.977 14.652H2.985v4.992m1.93-10.732a8.25 8.25 0 0 1 .164 6.57l-2.094-.83" stroke-linecap="round" stroke-linejoin="round"/> } }
templ IconCog(class string) { @Icon(class) { <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.592c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.219.127.325.198.72.26 1.075.128l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.245c.275.476.168 1.079-.252 1.434l-.992.838a1.125 1.125 0 0 0-.38 1.058 6.6 6.6 0 0 1 0 .49c-.04.38.1.759.38 1.058l.992.838c.42.355.527.958.252 1.434l-1.296 2.245a1.125 1.125 0 0 1-1.37.49l-1.217-.456a1.125 1.125 0 0 0-1.075.128 6.8 6.8 0 0 1-.219.127 1.125 1.125 0 0 0-.645.87l-.213 1.281c-.09.542-.56.94-1.11.94h-2.592c-.55 0-1.02-.398-1.11-.94l-.213-1.281a1.125 1.125 0 0 0-.645-.87 6.8 6.8 0 0 1-.219-.127 1.125 1.125 0 0 0-1.075-.128l-1.217.456a1.125 1.125 0 0 1-1.37-.49l-1.296-2.245a1.125 1.125 0 0 1 .252-1.434l.992-.838c.28-.299.42-.678.38-1.058a6.6 6.6 0 0 1 0-.49 1.125 1.125 0 0 0-.38-1.058l-.992-.838a1.125 1.125 0 0 1-.252-1.434L4.855 6.38a1.125 1.125 0 0 1 1.37-.49l1.217.456c.355.132.75.07 1.075-.128.072-.044.145-.087.219-.127.332-.184.582-.496.645-.87l.213-1.281Z"/><circle cx="12" cy="12" r="3"/> } }
templ IconPalette(class string) { @Icon(class) { <path d="M12 3a9 9 0 1 0 0 18h1.5a1.5 1.5 0 0 0 0-3H12a1.5 1.5 0 0 1 0-3h2.25A6.75 6.75 0 0 0 21 8.25C21 5.35 17 3 12 3Z"/><path d="M7.5 10.5h.008v.008H7.5V10.5Zm2.25-3h.008v.008H9.75V7.5Zm4.5 0h.008v.008h-.008V7.5Zm2.25 3h.008v.008H16.5V10.5Z" stroke-linecap="round"/> } }
templ IconArrowRightOnRectangle(class string) { @Icon(class) { <path d="M15.75 8.25 19.5 12l-3.75 3.75M19.5 12H9m3-7.5H5.25A2.25 2.25 0 0 0 3 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25H12" stroke-linecap="round" stroke-linejoin="round"/> } }
templ IconChevronDown(class string) { @Icon(class) { <path d="m6.75 9 5.25 5.25L17.25 9" stroke-linecap="round" stroke-linejoin="round"/> } }
templ IconChevronRight(class string) { @Icon(class) { <path d="m9 6.75 5.25 5.25L9 17.25" stroke-linecap="round" stroke-linejoin="round"/> } }
templ IconXMark(class string) { @Icon(class) { <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round"/> } }
templ IconCheck(class string) { <svg class={ class } viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon"><path fill-rule="evenodd" d="M16.704 5.29a.75.75 0 0 1 .006 1.06l-7.25 7.334a.75.75 0 0 1-1.065.002L3.29 8.58a.75.75 0 1 1 1.06-1.06l4.572 4.572 6.72-6.796a.75.75 0 0 1 1.062-.006Z" clip-rule="evenodd"/></svg> }
templ IconExclamationTriangle(class string) { @Icon(class) { <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" stroke-linecap="round" stroke-linejoin="round"/> } }
templ IconInformationCircle(class string) { @Icon(class) { <path d="M11.25 11.25 12 10.5m0 0 .75.75M12 10.5v5.25m0 5.25a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13.5h.008v.008H12V7.5Z" stroke-linecap="round"/> } }
templ IconChartBar(class string) { @Icon(class) { <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" stroke-linecap="round" stroke-linejoin="round"/> } }
templ IconMagnifyingGlass(class string) { @Icon(class) { <circle cx="10.75" cy="10.75" r="6.75"/><path d="m16 16 4.25 4.25" stroke-linecap="round"/> } }
