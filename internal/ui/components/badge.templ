package components

// ReleaseStatusBadge renders a colored badge for a release status string
// (store value: pending/deploying/live/failed/superseded).
templ ReleaseStatusBadge(status string) {
	switch status {
		case "live":
			<span class="badge badge-soft badge-success">
				<span class="status status-success"></span>
				Live
			</span>
		case "deploying":
			<span class="badge badge-soft badge-info animate-pulse">
				<span class="status status-info"></span>
				Deploying
			</span>
		case "pending":
			<span class="badge badge-soft badge-warning animate-pulse">
				<span class="status status-warning"></span>
				Pending
			</span>
		case "failed":
			<span class="badge badge-soft badge-error">
				<span class="status status-error"></span>
				Failed
			</span>
		case "superseded":
			<span class="badge badge-soft badge-neutral">Superseded</span>
		default:
			<span class="badge badge-soft badge-neutral">{ status }</span>
	}
}

// EnvLifecycleBadge renders a colored badge for an environment lifecycle status
// (store value: reserved/policy_blocked/ready/teardown_requested/torn_down/failed).
templ EnvLifecycleBadge(status string) {
	switch status {
		case "ready":
			<span class="badge badge-soft badge-success">
				<span class="status status-success"></span>
				Ready
			</span>
		case "torn_down":
			<span class="badge badge-soft badge-neutral">Torn Down</span>
		case "failed":
			<span class="badge badge-soft badge-error">Failed</span>
		case "policy_blocked":
			<span class="badge badge-soft badge-warning">Policy Blocked</span>
		case "reserved":
			<span class="badge badge-soft badge-warning animate-pulse">Provisioning</span>
		case "teardown_requested":
			<span class="badge badge-soft badge-warning animate-pulse">Tearing Down</span>
		default:
			<span class="badge badge-soft badge-neutral">{ status }</span>
	}
}

// RuntimeClassBadge shows a warning badge for unsandboxed apps.
templ RuntimeClassBadge(runtimeClass string) {
	if runtimeClass == "runc" {
		<span class="badge badge-soft badge-warning">⚠ UNSANDBOXED</span>
	}
}

// OperationStatusBadge renders a badge for an operation status
// (store value: queued/accepted/leased/running/completed/succeeded/failed/cancelled).
templ OperationStatusBadge(status string) {
	switch status {
		case "completed", "succeeded":
			<span class="badge badge-soft badge-success">Succeeded</span>
		case "leased", "running":
			<span class="badge badge-soft badge-info animate-pulse">Running</span>
		case "queued", "accepted":
			<span class="badge badge-soft badge-warning">Queued</span>
		case "failed":
			<span class="badge badge-soft badge-error">Failed</span>
		case "cancelled":
			<span class="badge badge-soft badge-neutral">Cancelled</span>
		default:
			<span class="badge badge-soft badge-neutral">{ status }</span>
	}
}
