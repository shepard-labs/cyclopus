package components

templ Badge(kind, text string) { <span class={ "inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium " + badgeTone(kind) }>{ text }</span> }

func badgeTone(kind string) string { switch kind { case "success": return "border-success/20 bg-success/10 text-base-content"; case "warning": return "border-warning/20 bg-warning/10 text-base-content"; case "error", "danger": return "border-error/20 bg-error/10 text-base-content"; case "primary", "brand", "info": return "border-primary/20 bg-primary/10 text-base-content"; default: return "border-line bg-base-300 text-base-content/70" } }

templ OperationalStatus(kind, label string) {
	<span class="inline-flex items-center gap-1.5 text-xs font-medium">
		<span aria-hidden="true" class={ "size-1.5 shrink-0 rounded-full " + statusDotTone(kind) }></span>
		<span>{ label }</span>
	</span>
}

func statusDotTone(kind string) string { switch kind { case "success": return "bg-success"; case "warning": return "bg-warning"; case "error", "danger": return "bg-error"; default: return "bg-base-content/40" } }

// ReleaseStatusBadge renders a colored badge for a release status string
// (store value: pending/deploying/live/failed/superseded).
templ ReleaseStatusBadge(status string) {
	switch status {
		case "live":
			@OperationalStatus("success", "Live")
		case "deploying":
			@OperationalStatus("warning", "Deploying")
		case "pending":
			@OperationalStatus("warning", "Pending")
		case "failed":
			@OperationalStatus("error", "Failed")
		case "superseded":
			@OperationalStatus("neutral", "Superseded")
		default:
			@OperationalStatus("neutral", status)
	}
}

// EnvLifecycleBadge renders a colored badge for an environment lifecycle status
// (store value: reserved/policy_blocked/ready/teardown_requested/torn_down/failed).
templ EnvLifecycleBadge(status string) {
	switch status {
		case "ready":
			@OperationalStatus("success", "Ready")
		case "torn_down":
			@OperationalStatus("neutral", "Torn Down")
		case "failed":
			@OperationalStatus("error", "Failed")
		case "policy_blocked":
			@OperationalStatus("warning", "Policy Blocked")
		case "reserved":
			@OperationalStatus("warning", "Provisioning")
		case "teardown_requested":
			@OperationalStatus("warning", "Tearing Down")
		default:
			@OperationalStatus("neutral", status)
	}
}

// RuntimeClassBadge shows a warning badge for unsandboxed apps.
templ RuntimeClassBadge(runtimeClass string) {
	if runtimeClass == "runc" {
		@Badge("warning", "⚠ UNSANDBOXED")
	}
}

// OperationStatusBadge renders a badge for an operation status
// (store value: queued/accepted/leased/running/completed/succeeded/failed/cancelled).
templ OperationStatusBadge(status string) {
	switch status {
		case "completed", "succeeded":
			@OperationalStatus("success", "Succeeded")
		case "leased", "running":
			@OperationalStatus("warning", "Running")
		case "queued", "accepted":
			@OperationalStatus("warning", "Queued")
		case "failed":
			@OperationalStatus("error", "Failed")
		case "cancelled":
			@OperationalStatus("neutral", "Cancelled")
		default:
			@OperationalStatus("neutral", status)
	}
}
