package components

// ReleaseStatusBadge renders a colored badge for a release status string.
templ ReleaseStatusBadge(status string) {
	switch status {
		case "RELEASE_STATUS_LIVE":
			<span class="badge badge-green">
				<span class="dot dot-green"></span>
				Live
			</span>
		case "RELEASE_STATUS_DEPLOYING":
			<span class="badge badge-blue animate-pulse">
				<span class="dot dot-blue"></span>
				Deploying
			</span>
		case "RELEASE_STATUS_PENDING":
			<span class="badge badge-yellow animate-pulse">
				<span class="dot dot-yellow"></span>
				Pending
			</span>
		case "RELEASE_STATUS_FAILED":
			<span class="badge badge-red">
				<span class="dot dot-red"></span>
				Failed
			</span>
		case "RELEASE_STATUS_SUPERSEDED":
			<span class="badge badge-gray">Superseded</span>
		default:
			<span class="badge badge-gray">{ status }</span>
	}
}

// EnvLifecycleBadge renders a colored badge for an environment lifecycle status.
templ EnvLifecycleBadge(status string) {
	switch status {
		case "ENVIRONMENT_LIFECYCLE_STATUS_READY":
			<span class="badge badge-green">
				<span class="dot dot-green"></span>
				Ready
			</span>
		case "ENVIRONMENT_LIFECYCLE_STATUS_TORN_DOWN":
			<span class="badge badge-gray">Torn Down</span>
		case "ENVIRONMENT_LIFECYCLE_STATUS_FAILED":
			<span class="badge badge-red">Failed</span>
		case "ENVIRONMENT_LIFECYCLE_STATUS_POLICY_BLOCKED":
			<span class="badge badge-yellow">Policy Blocked</span>
		case "ENVIRONMENT_LIFECYCLE_STATUS_RESERVED":
			<span class="badge badge-yellow animate-pulse">Provisioning</span>
		case "ENVIRONMENT_LIFECYCLE_STATUS_TEARDOWN_REQUESTED":
			<span class="badge badge-yellow animate-pulse">Tearing Down</span>
		default:
			<span class="badge badge-gray">{ status }</span>
	}
}

// RuntimeClassBadge shows a warning badge for unsandboxed apps.
templ RuntimeClassBadge(runtimeClass string) {
	if runtimeClass == "RUNTIME_CLASS_RUNC" {
		<span class="badge badge-amber">⚠ UNSANDBOXED</span>
	}
}

// OperationStatusBadge renders a badge for an operation status.
templ OperationStatusBadge(status string) {
	switch status {
		case "OPERATION_STATUS_SUCCEEDED":
			<span class="badge badge-green">Succeeded</span>
		case "OPERATION_STATUS_RUNNING":
			<span class="badge badge-blue animate-pulse">Running</span>
		case "OPERATION_STATUS_QUEUED":
			<span class="badge badge-yellow">Queued</span>
		case "OPERATION_STATUS_FAILED":
			<span class="badge badge-red">Failed</span>
		case "OPERATION_STATUS_CANCELLED":
			<span class="badge badge-gray">Cancelled</span>
		default:
			<span class="badge badge-gray">{ status }</span>
	}
}
