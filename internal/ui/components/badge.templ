package components

templ Badge(kind, text string) { <span class={ "inline-flex items-center gap-1.5 rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset " + badgeTone(kind) }>{ text }</span> }

func badgeTone(kind string) string { switch kind { case "success": return "bg-success/10 text-success ring-success/20"; case "warning": return "bg-warning/10 text-warning ring-warning/20"; case "error", "danger": return "bg-error/10 text-error ring-error/20"; case "primary", "brand", "info": return "bg-primary/10 text-primary ring-primary/20"; default: return "bg-base-200 text-base-content/70 ring-base-content/10" } }

// ReleaseStatusBadge renders a colored badge for a release status string
// (store value: pending/deploying/live/failed/superseded).
templ ReleaseStatusBadge(status string) {
	switch status {
		case "live":
			@Badge("success", "Live")
		case "deploying":
			@Badge("primary", "Deploying")
		case "pending":
			@Badge("warning", "Pending")
		case "failed":
			@Badge("error", "Failed")
		case "superseded":
			@Badge("neutral", "Superseded")
		default:
			@Badge("neutral", status)
	}
}

// EnvLifecycleBadge renders a colored badge for an environment lifecycle status
// (store value: reserved/policy_blocked/ready/teardown_requested/torn_down/failed).
templ EnvLifecycleBadge(status string) {
	switch status {
		case "ready":
			@Badge("success", "Ready")
		case "torn_down":
			@Badge("neutral", "Torn Down")
		case "failed":
			@Badge("error", "Failed")
		case "policy_blocked":
			@Badge("warning", "Policy Blocked")
		case "reserved":
			@Badge("warning", "Provisioning")
		case "teardown_requested":
			@Badge("warning", "Tearing Down")
		default:
			@Badge("neutral", status)
	}
}

// RuntimeClassBadge shows a warning badge for unsandboxed apps.
templ RuntimeClassBadge(runtimeClass string) {
	if runtimeClass == "runc" {
		@Badge("warning", "⚠ UNSANDBOXED")
	}
}

// OperationStatusBadge renders a badge for an operation status
// (store value: queued/accepted/leased/running/completed/succeeded/failed/cancelled).
templ OperationStatusBadge(status string) {
	switch status {
		case "completed", "succeeded":
			@Badge("success", "Succeeded")
		case "leased", "running":
			@Badge("primary", "Running")
		case "queued", "accepted":
			@Badge("warning", "Queued")
		case "failed":
			@Badge("error", "Failed")
		case "cancelled":
			@Badge("neutral", "Cancelled")
		default:
			@Badge("neutral", status)
	}
}
