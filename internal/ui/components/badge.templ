package components

// ReleaseStatusBadge renders a colored badge for a release status string
// (store value: pending/deploying/live/failed/superseded).
templ ReleaseStatusBadge(status string) {
	switch status {
		case "live":
			<wa-badge variant="success" appearance="accent">
				<span class="status status-success"></span>
				Live
			</wa-badge>
		case "deploying":
			<wa-badge variant="brand" appearance="accent" class="animate-pulse">
				<span class="status status-info"></span>
				Deploying
			</wa-badge>
		case "pending":
			<wa-badge variant="warning" appearance="accent" class="animate-pulse">
				<span class="status status-warning"></span>
				Pending
			</wa-badge>
		case "failed":
			<wa-badge variant="danger" appearance="accent">
				<span class="status status-error"></span>
				Failed
			</wa-badge>
		case "superseded":
			<wa-badge variant="neutral" appearance="accent">Superseded</wa-badge>
		default:
			<wa-badge variant="neutral" appearance="accent">{ status }</wa-badge>
	}
}

// EnvLifecycleBadge renders a colored badge for an environment lifecycle status
// (store value: reserved/policy_blocked/ready/teardown_requested/torn_down/failed).
templ EnvLifecycleBadge(status string) {
	switch status {
		case "ready":
			<wa-badge variant="success" appearance="accent">
				<span class="status status-success"></span>
				Ready
			</wa-badge>
		case "torn_down":
			<wa-badge variant="neutral" appearance="accent">Torn Down</wa-badge>
		case "failed":
			<wa-badge variant="danger" appearance="accent">Failed</wa-badge>
		case "policy_blocked":
			<wa-badge variant="warning" appearance="accent">Policy Blocked</wa-badge>
		case "reserved":
			<wa-badge variant="warning" appearance="accent" class="animate-pulse">Provisioning</wa-badge>
		case "teardown_requested":
			<wa-badge variant="warning" appearance="accent" class="animate-pulse">Tearing Down</wa-badge>
		default:
			<wa-badge variant="neutral" appearance="accent">{ status }</wa-badge>
	}
}

// RuntimeClassBadge shows a warning badge for unsandboxed apps.
templ RuntimeClassBadge(runtimeClass string) {
	if runtimeClass == "runc" {
		<wa-badge variant="warning" appearance="accent">⚠ UNSANDBOXED</wa-badge>
	}
}

// OperationStatusBadge renders a badge for an operation status
// (store value: queued/accepted/leased/running/completed/succeeded/failed/cancelled).
templ OperationStatusBadge(status string) {
	switch status {
		case "completed", "succeeded":
			<wa-badge variant="success" appearance="accent">Succeeded</wa-badge>
		case "leased", "running":
			<wa-badge variant="brand" appearance="accent" class="animate-pulse">Running</wa-badge>
		case "queued", "accepted":
			<wa-badge variant="warning" appearance="accent">Queued</wa-badge>
		case "failed":
			<wa-badge variant="danger" appearance="accent">Failed</wa-badge>
		case "cancelled":
			<wa-badge variant="neutral" appearance="accent">Cancelled</wa-badge>
		default:
			<wa-badge variant="neutral" appearance="accent">{ status }</wa-badge>
	}
}
