package components

templ Dialog(id, title string) {
	<el-dialog>
		<dialog id={ id } role="dialog" aria-modal="true" aria-labelledby={ id + "-title" } class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 backdrop-blur-sm transition-opacity data-closed:opacity-0 data-enter:duration-300 data-leave:duration-200"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 focus:outline-none sm:items-center">
			<el-dialog-panel class="relative w-full max-w-lg transform overflow-hidden rounded-box border border-line bg-base-300 p-6 text-left shadow-theme transition data-closed:translate-y-4 data-closed:opacity-0 data-closed:sm:scale-95">
					<div class="flex items-start justify-between gap-4"><h2 id={ id + "-title" } class="text-sm font-medium">{ title }</h2><button type="button" command="close" commandfor={ id } class="rounded-field p-1 text-base-content/50 hover:bg-base-300 hover:text-base-content"><span class="sr-only">Close</span>@IconXMark("size-5")</button></div>
					<div class="mt-4 text-sm">{ children... }</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}
