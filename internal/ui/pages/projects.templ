package pages

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Projects(projects []store.Project, org store.Organization, user store.User, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Projects", user, org, flash, "/projects", projectsContent(projects, errMsg))
}

templ projectsContent(projects []store.Project, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-xl font-semibold text-base-content">Projects</h1>
				<p class="text-sm text-base-content/65 mt-1">Organize your applications into projects.</p>
			</div>
		</div>
		<div class="card">
			<h2 class="text-sm font-semibold text-base-content/80 mb-4">New project</h2>
			if errMsg != "" {
				<div class="alert alert-error mb-4">{ errMsg }</div>
			}
			<form method="POST" action="/projects" class="flex items-end gap-3">
				<div class="fieldset flex-1">
					<label for="proj-name">Name</label>
					<input type="text" id="proj-name" name="name" required placeholder="My Project"/>
				</div>
				<div class="fieldset flex-1">
					<label for="proj-slug">Slug</label>
					<input type="text" id="proj-slug" name="slug" required placeholder="my-project" pattern="[a-z0-9-]+"/>
				</div>
				<button type="submit" class="btn btn-primary">Create</button>
			</form>
		</div>
		if len(projects) == 0 {
			<div class="card text-center py-12">
				<p class="text-base-content/65 text-sm">No projects yet. Create one above.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-3">
				for _, p := range projects {
					<a href={ templ.SafeURL("/projects/" + p.ID) } class="card flex items-center justify-between hover:border-base-content/30 transition-colors group">
						<div>
							<div class="font-medium text-base-content group-hover:text-accent transition-colors">{ p.Name }</div>
							<div class="text-xs text-base-content/50 mt-0.5">{ p.Slug }</div>
						</div>
						<svg class="w-4 h-4 text-base-content/35 group-hover:text-base-content/65" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<polyline points="9 18 15 12 9 6"></polyline>
						</svg>
					</a>
				}
			</div>
		}
	</div>
}
