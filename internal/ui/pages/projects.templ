package pages

import (
	"github.com/cyclopus-dev/cyclopus/internal/ui"
	"github.com/cyclopus-dev/cyclopus/internal/ui/components"
)

templ Projects(projects []ui.Project, org ui.Organization, user ui.User, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Projects", user, org, flash, "/projects", projectsContent(projects, errMsg))
}

templ projectsContent(projects []ui.Project, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-xl font-semibold text-zinc-100">Projects</h1>
				<p class="text-sm text-zinc-400 mt-1">Organize your applications into projects.</p>
			</div>
		</div>
		<div class="card">
			<h2 class="text-sm font-semibold text-zinc-300 mb-4">New project</h2>
			if errMsg != "" {
				<div class="flex items-center gap-2 p-3 mb-4 bg-red-500/20 border border-red-500/50 rounded text-sm text-red-400">{ errMsg }</div>
			}
			<form method="POST" action="/projects" class="flex items-end gap-3">
				<div class="input-group flex-1">
					<label for="proj-name">Name</label>
					<input type="text" id="proj-name" name="name" required placeholder="My Project"/>
				</div>
				<div class="input-group flex-1">
					<label for="proj-slug">Slug</label>
					<input type="text" id="proj-slug" name="slug" required placeholder="my-project" pattern="[a-z0-9-]+"/>
				</div>
				<button type="submit" class="btn btn-primary">Create</button>
			</form>
		</div>
		if len(projects) == 0 {
			<div class="card text-center py-12">
				<p class="text-zinc-400 text-sm">No projects yet. Create one above.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-3">
				for _, p := range projects {
					<a href={ templ.SafeURL("/projects/" + p.ID) } class="card flex items-center justify-between hover:border-zinc-600 transition-colors group">
						<div>
							<div class="font-medium text-zinc-100 group-hover:text-violet-300 transition-colors">{ p.Name }</div>
							<div class="text-xs text-zinc-500 mt-0.5">{ p.Slug }</div>
						</div>
						<svg class="w-4 h-4 text-zinc-600 group-hover:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<polyline points="9 18 15 12 9 6"></polyline>
						</svg>
					</a>
				}
			</div>
		}
	</div>
}
