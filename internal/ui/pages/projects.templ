package pages

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Projects(projects []store.Project, org store.Organization, user store.User, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Projects", user, org, flash, "/projects", projectsContent(projects, errMsg))
}

templ projectsContent(projects []store.Project, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-xl font-semibold text-base-content">Projects</h1>
				<p class="text-sm text-base-content/65 mt-1">Organize your applications into projects.</p>
			</div>
		</div>
		<div class="rounded-box bg-base-100 p-6 ring-1 ring-base-content/10">
			<h2 class="text-sm font-semibold text-base-content/80 mb-4">New project</h2>
			if errMsg != "" {
				<div class="mb-4">@components.Alert("error", errMsg)</div>
			}
			<form method="POST" action="/projects" class="flex items-end gap-3">
				<div class="flex-1"><label for="proj-name" class="block text-sm font-medium">Name</label><input type="text" id="proj-name" name="name" required placeholder="My Project" class="mt-2 w-full rounded-field px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
				<div class="flex-1"><label for="proj-slug" class="block text-sm font-medium">Slug</label><input type="text" id="proj-slug" name="slug" required placeholder="my-project" pattern="[a-z0-9-]+" class="mt-2 w-full rounded-field px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
				<button type="submit" class="rounded-field bg-primary px-4 py-2 text-sm font-semibold text-primary-content">Create</button>
			</form>
		</div>
		if len(projects) == 0 {
			@components.EmptyState("No projects yet", "Create your first project above.")
		} else {
			<div class="grid grid-cols-1 gap-3">
				for _, p := range projects {
					<a href={ templ.SafeURL("/projects/" + p.ID) } class="group flex items-center justify-between rounded-box bg-base-100 p-5 ring-1 ring-base-content/10 transition hover:ring-primary/40">
						<div>
							<div class="font-medium text-base-content group-hover:text-accent transition-colors">{ p.Name }</div>
							<div class="text-xs text-base-content/50 mt-0.5">{ p.Slug }</div>
						</div>
						@components.IconChevronRight("size-4 text-base-content/40 group-hover:text-primary")
					</a>
				}
			</div>
		}
	</div>
}
