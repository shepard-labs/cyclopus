package pages

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ AppOverview(app store.App, project store.Project, prodEnv *store.Environment, prodAlias *store.Alias, prodRelease *store.Release, previews []store.Environment, user store.User, org store.Organization, flash *ui.FlashMessage) {
	@components.Page(app.Name, user, org, flash, "/projects", appOverviewContent(app, project, prodEnv, prodAlias, prodRelease, previews))
}

templ appOverviewContent(app store.App, project store.Project, prodEnv *store.Environment, prodAlias *store.Alias, prodRelease *store.Release, previews []store.Environment) {
	<div class="space-y-6">
		<div class="flex items-center gap-2 text-xs text-base-content/65">
			<a href="/projects" class="hover:text-accent">Projects</a>
			<span>/</span>
			<a href={ templ.SafeURL("/projects/" + project.ID) } class="hover:text-accent">{ project.Name }</a>
			<span>/</span>
			<span class="text-base-content">{ app.Name }</span>
		</div>
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-3">
				@components.RuntimeClassBadge(app.RuntimeClass)
			</div>
			<a href={ templ.SafeURL("/apps/" + app.ID + "/settings") } class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium">Settings</a>
		</div>
		<section id="production-card" class="rounded-box border border-line bg-base-200 p-6">
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80">Production</h2>
				if prodEnv != nil {
					@components.EnvLifecycleBadge(prodEnv.LifecycleStatus)
				}
			</div>
			if prodEnv == nil {
				<p class="text-sm text-base-content/65">No production environment yet. Push to the default branch to create one.</p>
			} else {
				<div class="space-y-3">
					if prodAlias != nil && prodAlias.Hostname != "" {
						<div class="flex items-center justify-between">
							<span class="text-xs text-base-content/50">Hostname</span>
							<a href={ templ.SafeURL("https://" + prodAlias.Hostname) } target="_blank" rel="noopener" class="text-sm font-mono text-primary hover:text-accent">{ prodAlias.Hostname } ↗</a>
						</div>
					} else if prodEnv.PlannedHostname != nil {
						<div class="flex items-center justify-between">
							<span class="text-xs text-base-content/50">Planned hostname</span>
							<span class="text-sm font-mono text-base-content/65">{ strptr(prodEnv.PlannedHostname) }</span>
						</div>
					}
					if prodRelease != nil {
						<div class="flex items-center justify-between">
							<span class="text-xs text-base-content/50">Current release</span>
							<div class="flex items-center gap-2">
								@components.ReleaseStatusBadge(prodRelease.Status)
								<a href={ templ.SafeURL("/environments/" + prodEnv.ID) } class="text-xs text-base-content/65 font-mono hover:text-base-content/90">{ shortID(prodRelease.ID) }</a>
							</div>
						</div>
					}
					if prodEnv.InProgressReleaseID != nil {
						<div
							id="prod-status"
							role="status"
							class="flex items-center gap-2 rounded-box border border-line bg-base-300 p-4 text-sm text-primary animate-pulse"
							hx-get={ "/environments/" + prodEnv.ID + "/status-fragment" }
							hx-trigger="every 3s"
							hx-swap="outerHTML"
							hx-target="#prod-status"
						>
							@components.IconArrowPath("size-4 animate-spin")
							Deploy in progress…
						</div>
					}
					<div class="flex items-center gap-2 pt-2">
						<a href={ templ.SafeURL("/environments/" + prodEnv.ID) } class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium">View releases</a>
					</div>
				</div>
			}
		</section>
		<section class="rounded-box border border-line bg-base-200 p-6">
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80">Preview environments</h2>
				<span class="text-xs text-base-content/50">{ fmt.Sprintf("%d / %d", len(previews), app.MaxPreviewEnvironments) }</span>
			</div>
			if len(previews) == 0 {
				<p class="text-sm text-base-content/65">No preview environments. Push a non-default branch to create one.</p>
			} else {
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="border-b border-line text-xs text-base-content/50">
							<th class="text-left py-2">Branch</th>
							<th class="text-left py-2">Hostname</th>
							<th class="text-left py-2">Status</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, env := range previews {
							<tr class="text-base-content/80">
								<td class="py-2 font-mono text-xs">{ env.Branch }</td>
								<td class="py-2">
									if env.PlannedHostname != nil {
										<a href={ templ.SafeURL("https://" + strptr(env.PlannedHostname)) } target="_blank" rel="noopener" class="text-xs font-mono text-primary hover:text-accent truncate max-w-xs inline-block">{ strptr(env.PlannedHostname) } ↗</a>
									} else {
										<span class="text-xs text-base-content/50">—</span>
									}
								</td>
								<td class="py-2">@components.EnvLifecycleBadge(env.LifecycleStatus)</td>
								<td class="py-2 text-right">
							<a href={ templ.SafeURL("/environments/" + env.ID) } class="rounded-field px-2 py-1 text-sm font-medium hover:bg-base-300">View</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</section>
		<section class="rounded-box border border-line bg-base-200 p-6">
			<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80 mb-3">App configuration</h2>
			<div class="grid grid-cols-2 gap-4 text-xs">
				<div class="space-y-2">
					<div class="flex justify-between"><span class="text-base-content/50">Container port</span><span class="font-mono">{ fmt.Sprintf("%d", app.ContainerPort) }</span></div>
					<div class="flex justify-between"><span class="text-base-content/50">Health check</span><span class="font-mono">{ app.HealthCheckPath }</span></div>
					<div class="flex justify-between"><span class="text-base-content/50">Scaling</span><span>{ scalingModeLabel(app.ScalingMode) }</span></div>
					<div class="flex justify-between"><span class="text-base-content/50">Replicas</span><span>{ fmt.Sprintf("%d – %d", app.MinReplicas, app.MaxReplicas) }</span></div>
				</div>
				<div class="space-y-2">
					<div class="flex justify-between"><span class="text-base-content/50">CPU request</span><span class="font-mono">{ fmt.Sprintf("%dm", app.CPURequestMillicores) }</span></div>
					<div class="flex justify-between"><span class="text-base-content/50">CPU limit</span><span class="font-mono">{ fmt.Sprintf("%dm", app.CPULimitMillicores) }</span></div>
					<div class="flex justify-between"><span class="text-base-content/50">Memory request</span><span class="font-mono">{ fmt.Sprintf("%dMi", app.MemoryRequestMiB) }</span></div>
					<div class="flex justify-between"><span class="text-base-content/50">Memory limit</span><span class="font-mono">{ fmt.Sprintf("%dMi", app.MemoryLimitMiB) }</span></div>
				</div>
			</div>
		</section>
	</div>
}

func shortID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

func scalingModeLabel(mode string) string {
	switch mode {
	case "hpa":
		return "HPA"
	case "keda_cron":
		return "KEDA cron"
	case "keda_http":
		return "KEDA HTTP"
	default:
		return mode
	}
}
