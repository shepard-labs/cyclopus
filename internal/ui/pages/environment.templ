package pages

import (
	"fmt"
	"time"
	"github.com/shepard-labs/cyclopus/internal/service"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ EnvironmentDetail(
	env store.Environment,
	app store.App,
	project store.Project,
	releases []store.Release,
	alias *store.Alias,
	certs []service.CertificateStatus,
	domains []store.Domain,
	envVars store.EnvironmentVariableRevision,
	user store.User,
	org store.Organization,
	flash *ui.FlashMessage,
) {
	@components.Page("Environment — "+env.Branch, user, org, flash, "/projects", envDetailContent(env, app, project, releases, alias, certs, domains, envVars))
}

templ envDetailContent(
	env store.Environment,
	app store.App,
	project store.Project,
	releases []store.Release,
	alias *store.Alias,
	certs []service.CertificateStatus,
	domains []store.Domain,
	envVars store.EnvironmentVariableRevision,
) {
	<div class="space-y-6">
		<div class="flex items-center gap-2 text-xs text-base-content/65">
			<a href="/projects" class="hover:text-accent">Projects</a>
			<span>/</span>
			<a href={ templ.SafeURL("/projects/" + project.ID) } class="hover:text-accent">{ project.Name }</a>
			<span>/</span>
			<a href={ templ.SafeURL("/apps/" + app.ID) } class="hover:text-accent">{ app.Name }</a>
			<span>/</span>
			<span class="text-base-content">{ env.Branch }</span>
		</div>
		<div class="flex items-center gap-3">
			<h1 class="text-lg/7 font-semibold text-base-content">{ env.Branch }</h1>
			@components.EnvLifecycleBadge(env.LifecycleStatus)
			if env.TornDownAt != nil {
				<span class="text-xs text-base-content/50">torn down { relTime(*env.TornDownAt) }</span>
			}
		</div>
		if alias != nil && alias.Hostname != "" {
			<section class="flex items-center justify-between rounded-box border border-line bg-base-200 p-6">
				<div>
					<span class="text-xs text-base-content/50 block mb-1">Live URL</span>
					<a href={ templ.SafeURL("https://" + alias.Hostname) } target="_blank" rel="noopener" class="font-mono text-primary hover:text-accent">
						https://{ alias.Hostname } ↗
					</a>
				</div>
			</section>
		} else if env.PlannedHostname != nil {
			<section class="rounded-box border border-line bg-base-200 p-6">
				<span class="text-xs text-base-content/50 block mb-1">Planned hostname (cert pending)</span>
				<span class="font-mono text-base-content/80">{ strptr(env.PlannedHostname) }</span>
			</section>
		}
		<section class="rounded-box border border-line bg-base-200 p-6">
			<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80 mb-4">Releases</h2>
			if len(releases) == 0 {
				<p class="text-sm text-base-content/65">No releases yet.</p>
			} else {
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="border-b border-line text-xs text-base-content/50">
							<th class="text-left py-2 pr-4">ID</th>
							<th class="text-left py-2 pr-4">Status</th>
							<th class="text-left py-2 pr-4">Kind</th>
							<th class="text-left py-2 pr-4">Image</th>
							<th class="text-left py-2 pr-4">Commit</th>
							<th class="text-left py-2 pr-4">Time</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, r := range releases {
							<tr class="text-base-content/80">
								<td class="py-2 pr-4 font-mono text-xs text-base-content/65">{ shortID(r.ID) }</td>
								<td class="py-2 pr-4">@components.ReleaseStatusBadge(r.Status)</td>
								<td class="py-2 pr-4 text-xs text-base-content/50">{ releaseKindLabel(r.Kind) }</td>
								<td class="py-2 pr-4 font-mono text-xs text-base-content/65 max-w-xs truncate">{ shortImageRef(r.ImageRef) }</td>
								<td class="py-2 pr-4 font-mono text-xs text-base-content/65">
									if r.GitCommitSHA != nil {
										{ (*r.GitCommitSHA)[:min(7, len(*r.GitCommitSHA))] }
									} else {
										<span class="text-base-content/35">—</span>
									}
								</td>
								<td class="py-2 pr-4 text-xs text-base-content/50">{ relTime(r.CreatedAt) }</td>
								<td class="py-2 text-right">
									if r.Status != "live" && r.Status != "deploying" && r.Status != "pending" {
										<form method="POST" action={ templ.SafeURL("/environments/" + env.ID + "/rollback") }>
											<input type="hidden" name="release_id" value={ r.ID }/>
										<button type="submit" class="rounded-field px-2 py-1 text-sm font-medium hover:bg-base-300"
											onclick="return confirm('Roll back to release '+ this.form.release_id.value.substring(0,8) + '?')"
										>
											Rollback
										</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</section>
		<div class="grid grid-cols-1 gap-4">
			<section class="rounded-box border border-line bg-base-200 p-6">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80 mb-3">Environment variables</h2>
				if len(envVars.Variables) == 0 {
					<p class="text-sm text-base-content/65">No environment variables set.</p>
				} else {
					<div class="text-xs text-base-content/50 mb-2">Revision { fmt.Sprintf("%d", envVars.Revision) } · { len(envVars.Variables) } variables</div>
					<div class="space-y-1">
						for _, v := range envVars.Variables {
							<div class="flex items-center justify-between border-b border-line bg-base-300 px-3 py-2 last:border-0">
								<span class="font-mono text-xs text-base-content/80">{ v.Key }</span>
								<span class="text-xs text-base-content/35">••••••••</span>
							</div>
						}
					</div>
				}
			</section>
			<section class="rounded-box border border-line bg-base-200 p-6">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80 mb-3">Certificates</h2>
				if len(certs) == 0 {
					<p class="text-sm text-base-content/65">No certificates found.</p>
				} else {
					<table class="table-auto w-full text-sm">
						<thead>
							<tr class="border-b border-line text-xs text-base-content/50">
								<th class="text-left py-2">Hostname</th>
								<th class="text-left py-2">Status</th>
								<th class="text-left py-2">Expires</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, cert := range certs {
								<tr class="text-base-content/80">
									<td class="py-2 font-mono text-xs">{ cert.Hostname }</td>
								<td class="py-2">
									if cert.Ready {
										@components.Badge("success", "Ready")
									} else {
										@components.Badge("warning", cert.Reason)
										}
									</td>
									<td class="py-2 text-xs text-base-content/65">
										if cert.NotAfter != nil {
											{ cert.NotAfter.Format("2006-01-02") }
										} else {
											<span class="text-base-content/35">—</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
			<section class="rounded-box border border-line bg-base-200 p-6">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80 mb-3">Custom domains</h2>
				if len(domains) == 0 {
					<p class="text-sm text-base-content/65 mb-4">No custom domains configured.</p>
				} else {
					<table class="table-auto w-full text-sm mb-4">
						<thead>
							<tr class="border-b border-line text-xs text-base-content/50">
								<th class="text-left py-2">Hostname</th>
								<th class="text-left py-2">Method</th>
								<th class="text-left py-2">Verified</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, d := range domains {
								<tr class="text-base-content/80">
									<td class="py-2 font-mono text-xs">{ d.Hostname }</td>
									<td class="py-2 text-xs text-base-content/65">{ d.VerificationMethod }</td>
								<td class="py-2">
									if d.VerifiedAt != nil {
										@components.Badge("success", "Verified")
									} else {
										@components.Badge("warning", "Pending")
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
		</div>
	</div>
}

func relTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	}
}

func releaseKindLabel(kind string) string {
	switch kind {
	case "deploy":
		return "deploy"
	case "rollback":
		return "rollback"
	case "env_change":
		return "env change"
	case "reconcile":
		return "reconcile"
	default:
		return kind
	}
}

func shortImageRef(ref string) string {
	if idx := len(ref) - 1; idx > 32 {
		// show last 32 chars of digest
		if at := lastIndex(ref, "@"); at >= 0 {
			digest := ref[at+1:]
			if len(digest) > 20 {
				return "…" + digest[len(digest)-20:]
			}
		}
		return ref[len(ref)-32:]
	}
	return ref
}

func lastIndex(s, sub string) int {
	for i := len(s) - len(sub); i >= 0; i-- {
		if s[i:i+len(sub)] == sub {
			return i
		}
	}
	return -1
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
