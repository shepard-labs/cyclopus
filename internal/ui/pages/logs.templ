package pages

import (
	"net/url"
	"github.com/shepard-labs/cyclopus/internal/adapters/observability"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Logs(app store.App, project store.Project, entries []observability.LogEntry, nextCursor string, envID string, query string, user store.User, org store.Organization, flash *ui.FlashMessage) {
	@components.Page("Logs — "+app.Name, user, org, flash, "/projects", logsContent(app, project, entries, nextCursor, envID, query))
}

templ logsContent(app store.App, project store.Project, entries []observability.LogEntry, nextCursor string, envID string, query string) {
	<div class="space-y-4 h-full flex flex-col">
		<div class="flex items-center gap-2 text-sm text-base-content/65">
			<a href="/projects" class="hover:text-accent">Projects</a>
			<span>/</span>
			<a href={ templ.SafeURL("/projects/" + project.ID) } class="hover:text-accent">{ project.Name }</a>
			<span>/</span>
			<a href={ templ.SafeURL("/apps/" + app.ID) } class="hover:text-accent">{ app.Name }</a>
			<span>/</span>
			<span class="text-base-content">Logs</span>
		</div>
		<div class="flex items-center gap-3">
			<h1 class="text-xl font-semibold">Logs</h1>
			<form method="GET" action={ templ.SafeURL("/apps/" + app.ID + "/logs") } class="flex items-center gap-2 ml-auto">
				if envID != "" {
					<input type="hidden" name="env" value={ envID }/>
				}
				<label for="log-query" class="sr-only">Filter logs</label><input id="log-query" type="text" name="q" value={ query } placeholder="Filter logs…" class="w-64 rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/>
				<button type="submit" class="rounded-field px-3 py-2 text-sm font-semibold ring-1 ring-base-content/20">Search</button>
			</form>
		</div>
		<div class="flex flex-1 flex-col overflow-hidden rounded-box bg-[#09090b] text-zinc-100 ring-1 ring-base-content/10">
			<div id="log-entries" class="flex-1 overflow-y-auto p-4 font-mono text-xs leading-6">
				if len(entries) == 0 && nextCursor == "" {
					<div class="text-base-content/50 text-center py-8">No log entries found.</div>
				} else {
					@LogsEntriesFragment(app.ID, entries, nextCursor, envID, query)
				}
			</div>
		</div>
	</div>
}

templ LogsEntriesFragment(appID string, entries []observability.LogEntry, nextCursor string, envID string, query string) {
	<div class="log-entries-fragment contents">
		for _, e := range entries {
			<div class="flex gap-3 border-b border-white/5 py-0.5 last:border-0">
				<span class="text-base-content/35 flex-shrink-0">{ e.Timestamp.Format("15:04:05.000") }</span>
				<span class={ logSeverityClass(e.Severity) + " flex-shrink-0 w-12 text-right uppercase text-xs font-mono" }>{ shortSeverity(e.Severity) }</span>
				<span class="text-base-content/80 break-all">{ e.Body }</span>
			</div>
		}
		if nextCursor != "" {
			<div class="log-load-more p-3 border-t border-base-300">
				<button type="button" class="flex w-full items-center justify-center gap-2 rounded-field px-3 py-2 text-sm font-semibold ring-1 ring-white/20"
					hx-get={ logsNextURL(appID, nextCursor, envID, query) }
					hx-target="closest .log-load-more"
					hx-swap="outerHTML"
					hx-indicator="find .load-more-spinner"
				>
					Load older entries
					<span role="status" aria-live="polite" class="load-more-spinner htmx-indicator inline-flex items-center gap-2 text-xs font-normal text-zinc-300"><span class="size-4 animate-spin rounded-full border-2 border-zinc-500 border-t-zinc-100" aria-hidden="true"></span><span>Loading…</span></span>
				</button>
			</div>
		}
	</div>
}

func logsNextURL(appID string, cursor string, envID string, query string) templ.SafeURL {
	values := url.Values{"cursor": {cursor}, "load_more": {"true"}}
	if envID != "" {
		values.Set("env", envID)
	}
	if query != "" {
		values.Set("q", query)
	}
	return templ.SafeURL("/apps/" + url.PathEscape(appID) + "/logs?" + values.Encode())
}

func logSeverityClass(sev observability.Severity) string {
	switch sev {
	case observability.SeverityError, observability.SeverityFatal:
		return "text-error"
	case observability.SeverityWarn:
		return "text-warning"
	case observability.SeverityInfo:
		return "text-info"
	case observability.SeverityDebug, observability.SeverityTrace:
		return "text-base-content/50"
	default:
		return "text-base-content/65"
	}
}

func shortSeverity(sev observability.Severity) string {
	switch sev {
	case observability.SeverityFatal:
		return "FATAL"
	case observability.SeverityError:
		return "ERROR"
	case observability.SeverityWarn:
		return "WARN"
	case observability.SeverityInfo:
		return "INFO"
	case observability.SeverityDebug:
		return "DEBUG"
	case observability.SeverityTrace:
		return "TRACE"
	default:
		return "?"
	}
}
