package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Login(errMsg string) {
	@components.AuthPage("Sign in") {
		<div class="w-full max-w-sm">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 mb-4">
					<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
					<span class="text-2xl font-bold">Cyclopus</span>
				</div>
				<h1 class="text-xl font-semibold text-base-content">Sign in to your install</h1>
			</div>
			<div class="card">
				if errMsg != "" {
					<div class="alert alert-error mb-4">
						<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
						{ errMsg }
					</div>
				}
				<form method="POST" action="/login" class="space-y-4">
					<div class="fieldset">
						<label for="email">Email address</label>
						<input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email"/>
					</div>
					<div class="fieldset">
						<label for="password">Password</label>
						<input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password"/>
					</div>
					<button type="submit" class="btn btn-primary w-full justify-center mt-2">Sign in</button>
				</form>
			</div>
		</div>
	}
}
