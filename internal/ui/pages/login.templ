package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Login(errMsg string) {
	@components.AuthPage("Sign in") {
		<div class="w-full max-w-sm">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 mb-4">
					@components.IconLogo("size-8 text-primary")
					<span class="text-2xl font-bold">Cyclopus</span>
				</div>
				<h1 class="text-xl font-semibold text-base-content">Sign in to your install</h1>
			</div>
			<div class="rounded-box bg-base-100 p-6 shadow-theme ring-1 ring-base-content/10">
				if errMsg != "" {
					<div class="mb-4">@components.Alert("error", errMsg)</div>
				}
				<form method="POST" action="/login" class="space-y-4">
					<div><label for="email" class="block text-sm font-medium">Email address</label><input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" class="mt-2 block w-full rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
					<div><label for="password" class="block text-sm font-medium">Password</label><input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password" class="mt-2 block w-full rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
					<button type="submit" class="mt-2 w-full rounded-field bg-primary px-3 py-2 text-sm font-semibold text-primary-content hover:opacity-90">Sign in</button>
				</form>
			</div>
		</div>
	}
}
