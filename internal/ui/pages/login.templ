package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Login(errMsg string) {
	@components.AuthPage("Sign in") {
		<div class="w-full max-w-sm">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 mb-4">
					<wa-icon name="circle-info" class="w-8 h-8 text-primary" aria-hidden="true"></wa-icon>
					<span class="text-2xl font-bold">Cyclopus</span>
				</div>
				<h1 class="text-xl font-semibold text-base-content">Sign in to your install</h1>
			</div>
			<wa-card>
				if errMsg != "" {
					<wa-callout variant="danger" class="mb-4">
						<wa-icon name="xmark" class="w-4 h-4 flex-shrink-0" aria-hidden="true"></wa-icon>
						{ errMsg }
					</wa-callout>
				}
				<form method="POST" action="/login" class="space-y-4">
					<div class="fieldset">
						<wa-input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" label="Email address"></wa-input>
					</div>
					<div class="fieldset">
						<wa-input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password" label="Password"></wa-input>
					</div>
					<wa-button type="submit" variant="brand" class="w-full mt-2">Sign in</wa-button>
				</form>
			</wa-card>
		</div>
	}
}
