package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Login(errMsg string) {
	@components.AuthPage("Sign in") {
		<div class="w-full max-w-sm">
			<div class="mb-8 text-center">
				<div class="mb-4 inline-flex items-center gap-2">
					@components.IconLogo("size-8 text-primary")
					<span class="text-xl font-medium">Cyclopus</span>
				</div>
				<h1 class="text-lg/7 font-medium text-base-content">Sign in to your install</h1>
			</div>
			<div class="rounded-box border border-line bg-base-200 p-6 shadow-auth-glow">
				if errMsg != "" {
					<div class="mb-4">@components.Alert("error", errMsg)</div>
				}
				<form method="POST" action="/login" class="space-y-4">
					<div><label for="email" class="block text-xs font-medium">Email address</label><input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/></div>
					<div><label for="password" class="block text-xs font-medium">Password</label><input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password" class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/></div>
					<button type="submit" class="mt-2 w-full rounded-field bg-primary px-3 py-2 text-sm font-medium text-primary-content hover:opacity-90">Sign in</button>
				</form>
			</div>
		</div>
	}
}
