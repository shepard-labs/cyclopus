package settings

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Theme(user store.User, org store.Organization, flash *ui.FlashMessage) { @components.Page("Theme", user, org, flash, "/settings/theme", themeContent()) }

templ themeContent() {
	<div class="max-w-4xl space-y-6"><div><h1 class="text-lg/7 font-semibold">Theme</h1><p class="mt-1 text-xs text-base-content/65">Applies instantly and is remembered on this device.</p></div>
		<section class="rounded-box border border-line bg-base-200 p-6"><div id="theme-grid" class="grid gap-4 sm:grid-cols-2"></div></section>
		<script>
			(function(){var themes=window.cyclopusTheme.themes,grid=document.getElementById('theme-grid');Object.keys(themes).forEach(function(name){var t=themes[name],v=t.vars,b=document.createElement('button'),preview=document.createElement('span');b.id='theme-'+name;b.type='button';b.setAttribute('role','button');b.setAttribute('data-theme-name',name);b.setAttribute('aria-pressed','false');b.setAttribute('aria-label','Use '+t.label+' theme');b.className='group rounded-box border border-line bg-base-300 p-4 text-left outline-none transition hover:border-primary/50 focus-visible:ring-2 focus-visible:ring-base-content focus-visible:ring-offset-2 focus-visible:ring-offset-base-200 aria-pressed:border-primary aria-pressed:ring-2 aria-pressed:ring-primary/20';preview.setAttribute('data-theme-preview','');var swatches=['--color-base-100','--color-base-300','--color-primary','--color-warning','--color-error','--color-success'].map(function(k){return '<span class="size-5 rounded-full ring-1 ring-line" style="background:'+v[k]+'"></span>'}).join('');preview.innerHTML='<span class="flex items-start justify-between gap-3"><span><span class="block font-semibold" style="font-family:'+v['--font-sans']+'">'+t.label+'</span><span class="mt-1 block text-xs opacity-60">'+t.desc+'</span></span><span class="rounded-box border border-line bg-base-300 px-2 py-0.5 text-xs opacity-70">'+(t.dark?'Dark':'Light')+'</span></span><span class="mt-4 flex gap-2">'+swatches+'</span><span class="mt-4 flex items-center gap-3 rounded-field border border-line bg-base-300 p-3 shadow-auth-glow" style="background:'+v['--color-base-300']+'"><b style="color:'+v['--color-base-content']+';font-family:'+v['--font-sans']+'">Aa</b><b style="color:'+v['--color-primary']+';font-family:'+v['--font-mono']+'">Aa</b></span>';b.appendChild(preview);b.onclick=function(){window.cyclopusTheme.apply(name)};grid.appendChild(b)});window.cyclopusTheme.sync()})()
		</script>
	</div>
}
