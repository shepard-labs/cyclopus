package settings

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Theme(user store.User, org store.Organization, flash *ui.FlashMessage) {
	@components.Page("Theme", user, org, flash, "/settings/theme", themeContent())
}

templ themeContent() {
	<div class="max-w-3xl space-y-6">
		<div>
			<h1 class="text-xl font-semibold">Theme</h1>
			<p class="text-sm text-base-content/50 mt-1">Applies instantly and is remembered on this device.</p>
		</div>
		<wa-card>
			<div class="theme-grid" id="theme-grid"></div>
			<script>
				(function () {
					var grid = document.getElementById('theme-grid')
					var themes = window.cyclopusTheme.themes
					Object.keys(themes).forEach(function (name) {
						var t = themes[name]
						var v = t.vars
						var b = document.createElement('button')
						b.type = 'button'
						b.className = 'theme-option'
						b.setAttribute('data-theme-name', name)
						b.setAttribute('aria-pressed', 'false')
						var swatches = ['--wa-color-surface-default', '--wa-color-surface-lowered', '--wa-color-brand-fill-loud', '--wa-color-warning-fill-loud', '--wa-color-danger-fill-loud', '--wa-color-success-fill-loud']
							.map(function (k) {
								return '<span class="theme-swatch" style="background:' + v[k] + '"></span>'
							}).join('')
						b.innerHTML =
							'<span class="theme-type" style="background:' + v['--wa-color-surface-default'] + ';border-radius:' + v['--wa-border-radius-m'] + '">' +
								'<b style="color:' + v['--wa-color-text-normal'] + ';font-family:' + v['--wa-font-family-body'] + '">Aa</b>' +
								'<b style="color:' + v['--wa-color-brand-fill-loud'] + ';font-family:' + v['--wa-font-family-code'] + '">Aa</b>' +
							'</span>' +
							'<span class="theme-option-head">' +
								'<span class="theme-option-label" style="font-family:' + v['--wa-font-family-body'] + '">' + t.label + '</span>' +
								'<span class="theme-option-mode" style="font-family:' + v['--wa-font-family-body'] + '">' + (t.dark ? 'Dark' : 'Light') + '</span>' +
							'</span>' +
							'<span class="theme-option-desc" style="color:' + v['--cyclopus-dim'] + ';font-family:' + v['--wa-font-family-body'] + '">' + t.desc + '</span>' +
							'<span class="theme-swatches">' + swatches + '</span>'
						b.onclick = function () { window.cyclopusTheme.apply(name) }
						grid.appendChild(b)
					})
					window.cyclopusTheme.sync()
				})()
			</script>
		</wa-card>
	</div>
}
