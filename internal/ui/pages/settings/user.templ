package settings

import (
	"github.com/shepard-labs/cyclopus/internal/avatar"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ User(user store.User, org store.Organization, flash *ui.FlashMessage, profileError, passwordError, openDialog string) { @components.Page("User Settings", user, org, flash, "/settings/user", userContent(user, profileError, passwordError, openDialog)) }

templ userField(id, name, label, typ, value, autocomplete, maxlength, placeholder string, required bool) { <div><label for={ id } class="block text-xs font-medium">{ label }</label><input id={ id } name={ name } type={ typ } value={ value } autocomplete={ autocomplete } maxlength={ maxlength } placeholder={ placeholder } required?={ required } class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/></div> }

templ userContent(user store.User, profileError, passwordError, openDialog string) {
	<div class="max-w-3xl space-y-6">
		<section class="space-y-4 rounded-box border border-line bg-base-200 p-6"><h2 class="text-sm font-semibold">Profile</h2>if profileError != "" && openDialog == "" {
			@components.Alert("error", profileError)
		}
			<button type="button" command="show-modal" commandfor="avatar-dialog" aria-controls="avatar-dialog" aria-label="Change avatar" class="cursor-pointer rounded-full outline-none focus-visible:ring-2 focus-visible:ring-base-content focus-visible:ring-offset-2 focus-visible:ring-offset-base-100"><img class="size-20 rounded-full bg-base-200" src={ avatar.URL(user.AvatarKey) } alt="Current avatar"/></button>
			<form id="profile-form" method="POST" action="/settings/user/profile" class="space-y-4"><input type="hidden" name="action" value="profile"/><div class="grid gap-4 sm:grid-cols-2">@userField("first-name","first_name","First name","text",user.FirstName,"given-name","100","",false)@userField("last-name","last_name","Last name","text",user.LastName,"family-name","100","",false)</div>@userField("display-name","display_name","Display name","text",user.DisplayName,"nickname","200","How you appear in Cyclopus",false)<button id="profile-save" type="submit" disabled class="cursor-pointer rounded-field bg-primary px-4 py-2 text-sm font-medium text-primary-content disabled:cursor-not-allowed disabled:opacity-40">Save</button></form>
			<script>(function(){var f=document.getElementById('profile-form'),b=document.getElementById('profile-save'),i=new FormData(f);f.addEventListener('input',function(){var c=new FormData(f);b.disabled=['first_name','last_name','display_name'].every(function(n){return c.get(n)===i.get(n)})})})()</script>
		</section>
		<section class="flex items-center justify-between rounded-box border border-line bg-base-200 p-6"><div><h2 class="text-sm font-semibold">Email</h2><p class="mt-1 text-xs text-base-content/65">{ user.Email }</p></div><button type="button" command="show-modal" commandfor="email-dialog" aria-controls="email-dialog" class="cursor-pointer rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium">Update</button></section>
		<section class="flex items-center justify-between rounded-box border border-line bg-base-200 p-6"><div><h2 class="text-sm font-semibold">Password</h2><p class="mt-1 text-xs text-base-content/65">Change your password and sign out other sessions.</p></div><button type="button" command="show-modal" commandfor="password-dialog" aria-controls="password-dialog" class="cursor-pointer rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium">Update</button></section>
		@components.Dialog("avatar-dialog", "Choose an avatar") {
			if profileError != "" && openDialog == "avatar" {
				@components.Alert("error", profileError)
			}
			<form method="POST" action="/settings/user/profile" class="mt-4 space-y-4"><input type="hidden" name="action" value="avatar"/><fieldset><legend class="sr-only">Avatar</legend><div class="grid grid-cols-4 gap-3">
				for _, key := range avatar.Keys {
					<label class="group relative flex cursor-pointer items-center justify-center rounded-full p-1 outline-none transition has-focus-visible:ring-2 has-focus-visible:ring-base-content has-focus-visible:ring-offset-2 has-focus-visible:ring-offset-base-200"><input type="radio" name="avatar_key" value={ key } checked?={ key == user.AvatarKey } required class="peer sr-only"/><img src={ avatar.URL(key) } alt={ "Avatar option " + key } class="size-14 rounded-full opacity-70 transition group-hover:scale-110 group-hover:opacity-100 peer-checked:opacity-100 peer-checked:ring-2 peer-checked:ring-primary"/></label>
				}
			</div></fieldset><div class="flex justify-end gap-3"><button type="button" command="close" commandfor="avatar-dialog" class="cursor-pointer rounded-field px-3 py-2 text-sm font-medium">Cancel</button><button type="submit" class="cursor-pointer rounded-field bg-primary px-4 py-2 text-sm font-medium text-primary-content">Save</button></div></form>
		}
		@components.Dialog("email-dialog", "Update email") {
			if profileError != "" && openDialog == "email" {
				@components.Alert("error", profileError)
			}
			<form method="POST" action="/settings/user/profile" class="mt-4 space-y-4"><input type="hidden" name="action" value="email"/>@userField("new-email","email","New email","email",user.Email,"email","320","",true)@userField("email-password","current_password","Current password","password","","current-password","","",true)<div class="flex justify-end gap-3"><button type="button" command="close" commandfor="email-dialog" class="cursor-pointer rounded-field px-3 py-2 text-sm font-medium">Cancel</button><button type="submit" class="cursor-pointer rounded-field bg-primary px-4 py-2 text-sm font-medium text-primary-content">Save</button></div></form>
		}
		@components.Dialog("password-dialog", "Change password") {
			if passwordError != "" {
				@components.Alert("error", passwordError)
			}
			<form method="POST" action="/settings/user/password" class="mt-4 space-y-4">@userField("current-password","current_password","Current password","password","","current-password","","",true)<div><label for="new-password" class="block text-xs font-medium">New password</label><input id="new-password" name="new_password" type="password" minlength="8" autocomplete="new-password" required class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/></div><div><label for="confirm-password" class="block text-xs font-medium">Confirm new password</label><input id="confirm-password" name="confirm_password" type="password" minlength="8" autocomplete="new-password" required class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/></div><div class="flex justify-end gap-3"><button type="button" command="close" commandfor="password-dialog" class="cursor-pointer rounded-field px-3 py-2 text-sm font-medium">Cancel</button><button type="submit" class="cursor-pointer rounded-field bg-primary px-4 py-2 text-sm font-medium text-primary-content">Save</button></div></form>
		}
		if openDialog != "" {
			<div hidden data-open-dialog={ openDialog + "-dialog" }></div>
			<script>(function(){var marker=document.currentScript.previousElementSibling,d=document.getElementById(marker.dataset.openDialog);if(d){d.showModal()}})()</script>
		}
	</div>
}
