package settings

import (
	"github.com/shepard-labs/cyclopus/internal/avatar"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ User(user store.User, org store.Organization, flash *ui.FlashMessage, profileError, passwordError, openDialog string) {
	@components.Page("User Settings", user, org, flash, "/settings/user", userContent(user, profileError, passwordError, openDialog))
}

templ userContent(user store.User, profileError, passwordError, openDialog string) {
	<div class="user-settings max-w-3xl space-y-6">
		<div>
			<h1 class="text-xl font-semibold">User Settings</h1>
			<p class="text-sm text-base-content/50 mt-1">Manage your profile and account security.</p>
		</div>

		<wa-card class="space-y-4">
			<div>
				<h2 class="text-sm font-semibold text-base-content/90">Profile</h2>
			</div>
			if profileError != "" && openDialog == "" {
				<wa-callout variant="danger">{ profileError }</wa-callout>
			}
			<div class="profile-avatar-row">
				<wa-button type="button" appearance="plain" class="current-avatar" onclick="openSettingsDialog('avatar-dialog')" aria-label="Change avatar">
					<img src={ avatar.URL(user.AvatarKey) } alt="Current avatar"/>
				</wa-button>
			</div>
			<form id="profile-form" method="POST" action="/settings/user/profile" class="space-y-4">
				<input type="hidden" name="action" value="profile"/>
				<div class="grid grid-cols-2 gap-4">
					<wa-input id="first-name" name="first_name" label="First name" value={ user.FirstName } maxlength="100" autocomplete="given-name"></wa-input>
					<wa-input id="last-name" name="last_name" label="Last name" value={ user.LastName } maxlength="100" autocomplete="family-name"></wa-input>
				</div>
				<wa-input id="display-name" name="display_name" label="Display name" value={ user.DisplayName } maxlength="200" autocomplete="nickname" placeholder="How you appear in Cyclopus"></wa-input>
				<div class="profile-actions"><wa-button id="profile-save" type="submit" variant="brand" disabled>Save</wa-button></div>
			</form>
			<script>
				customElements.whenDefined('wa-input').then(function () {
					const form = document.getElementById('profile-form')
					const save = document.getElementById('profile-save')
					const initial = new FormData(form)
					function updateSaveState() {
						const current = new FormData(form)
						save.disabled = ['first_name', 'last_name', 'display_name'].every(function (name) {
							return current.get(name) === initial.get(name)
						})
					}
					form.addEventListener('input', updateSaveState)
					form.addEventListener('reset', function () { requestAnimationFrame(updateSaveState) })
				})
			</script>
		</wa-card>

		<wa-card class="settings-row">
			<div>
				<h2 class="text-sm font-semibold text-base-content/90">Email</h2>
				<p class="text-sm text-base-content/50 mt-1">{ user.Email }</p>
			</div>
			<wa-button type="button" appearance="plain" onclick="openSettingsDialog('email-dialog')">Update</wa-button>
		</wa-card>

		<wa-card class="settings-row">
			<div>
				<h2 class="text-sm font-semibold text-base-content/90">Password</h2>
				<p class="text-sm text-base-content/50 mt-1">Change your password and sign out other sessions.</p>
			</div>
			<wa-button type="button" appearance="plain" onclick="openSettingsDialog('password-dialog')">Update</wa-button>
		</wa-card>

		<wa-dialog id="avatar-dialog" label="Choose an avatar" class="settings-dialog">
			<p class="text-sm text-base-content/50 mb-4">Select the avatar you want to use.</p>
				if profileError != "" && openDialog == "avatar" {
					<wa-callout variant="danger">{ profileError }</wa-callout>
				}
				<form method="POST" action="/settings/user/profile" class="space-y-4">
					<input type="hidden" name="action" value="avatar"/>
					<wa-radio-group name="avatar_key" value={ user.AvatarKey } label="Avatar" required class="avatar-picker">
						for _, key := range avatar.Keys {
							<wa-radio value={ key } class="avatar-option">
								<img src={ avatar.URL(key) } alt=""/>
								<span class="sr-only">Avatar option { key }</span>
							</wa-radio>
						}
					</wa-radio-group>
					<div class="dialog-actions">
						<wa-button type="button" appearance="plain" onclick="this.closest('wa-dialog').open=false">Cancel</wa-button>
						<wa-button type="submit" variant="brand">Save</wa-button>
					</div>
				</form>
		</wa-dialog>

		<wa-dialog id="email-dialog" label="Update email" class="settings-dialog">
			<p class="text-sm text-base-content/50 mb-4">Enter your new email and current password.</p>
				if profileError != "" && openDialog == "email" {
					<wa-callout variant="danger">{ profileError }</wa-callout>
				}
				<form method="POST" action="/settings/user/profile" class="space-y-4">
					<input type="hidden" name="action" value="email"/>
					<wa-input type="email" id="new-email" name="email" label="New email" value={ user.Email } maxlength="320" autocomplete="email" required></wa-input>
					<wa-input type="password" id="email-password" name="current_password" label="Current password" autocomplete="current-password" required></wa-input>
					<div class="dialog-actions">
						<wa-button type="button" appearance="plain" onclick="this.closest('wa-dialog').open=false">Cancel</wa-button>
						<wa-button type="submit" variant="brand">Save</wa-button>
					</div>
				</form>
		</wa-dialog>

		<wa-dialog id="password-dialog" label="Change password" class="settings-dialog">
			<p class="text-sm text-base-content/50 mb-4">Other signed-in sessions will be revoked.</p>
				if passwordError != "" {
					<wa-callout variant="danger">{ passwordError }</wa-callout>
				}
				<form method="POST" action="/settings/user/password" class="space-y-4">
					<wa-input type="password" id="current-password" name="current_password" label="Current password" autocomplete="current-password" required></wa-input>
					<wa-input type="password" id="new-password" name="new_password" label="New password" minlength="8" autocomplete="new-password" required></wa-input>
					<wa-input type="password" id="confirm-password" name="confirm_password" label="Confirm new password" minlength="8" autocomplete="new-password" required></wa-input>
					<div class="dialog-actions">
						<wa-button type="button" appearance="plain" onclick="this.closest('wa-dialog').open=false">Cancel</wa-button>
						<wa-button type="submit" variant="brand">Save</wa-button>
					</div>
				</form>
		</wa-dialog>
		<script>
			window.openSettingsDialog = function (id) {
				customElements.whenDefined('wa-dialog').then(function () {
					var dialog = document.getElementById(id)
					if (dialog) { dialog.open = true }
				})
			}
		</script>
		if openDialog == "avatar" {
			<script>openSettingsDialog('avatar-dialog')</script>
		} else if openDialog == "email" {
			<script>openSettingsDialog('email-dialog')</script>
		} else if openDialog == "password" {
			<script>openSettingsDialog('password-dialog')</script>
		}
	</div>
}
