package settings

import (
	"strings"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Tokens(tokens []store.APIToken, createdToken string, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("API Tokens", user, org, flash, "/settings/tokens", tokensContent(tokens, createdToken, errMsg))
}

templ tokensContent(tokens []store.APIToken, createdToken string, errMsg string) {
	<div class="space-y-6 max-w-3xl">
		if createdToken != "" {
			<div role="status" class="space-y-2 rounded-box border border-success/30 bg-success/10 p-4">
				<p class="text-sm font-semibold text-base-content"><span aria-hidden="true" class="mr-1.5 inline-block size-1.5 rounded-full bg-success"></span>Token created — save it now. It will not be shown again.</p>
				<code class="block break-all rounded-field border border-success/20 bg-base-300 p-3 font-mono text-xs text-base-content">{ createdToken }</code>
			</div>
		}
		@components.SectionCard("Create token") {
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<form method="POST" action="/settings/tokens" class="space-y-4">
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						@components.FormField("tok-name", "name", "Name", "text", "", "CI deploy token", true)
					</div>
					<div>
						@components.FormField("tok-scopes", "scopes", "Scopes", "text", "", "deploy:app-id", false)
					</div>
				</div>
				@components.Button(components.ButtonProps{
					Type:    components.ButtonTypeSubmit,
					Variant: components.ButtonVariantPrimary,
				}) {
					Create token
				}
			</form>
		}
		if len(tokens) > 0 {
			@components.Card("") {
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="border-b border-line text-xs uppercase tracking-wider text-base-content/50">
							<th class="text-left py-2">Name</th>
							<th class="text-left py-2">Scopes</th>
							<th class="text-left py-2">Last used</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, t := range tokens {
							<tr class="bg-base-300/40 text-base-content/80">
								<td class="py-2 text-sm">{ t.Name }</td>
								<td class="py-2 text-xs font-mono text-base-content/65">{ strings.Join(t.Scopes, ", ") }</td>
								<td class="py-2 text-xs text-base-content/50">
									if t.LastUsedAt != nil {
										{ relTimeSettings(*t.LastUsedAt) }
									} else {
										<span class="text-base-content/35">Never</span>
									}
								</td>
								<td class="py-2 text-right">
									<form method="POST" action={ templ.SafeURL("/settings/tokens/" + t.ID + "/revoke") } onsubmit="return confirm('Revoke this token?')">
										@components.Button(components.ButtonProps{
											Type:    components.ButtonTypeSubmit,
											Variant: components.ButtonVariantDanger,
										}) {
											Revoke
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</div>
}
