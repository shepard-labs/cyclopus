package settings

import (
	"strings"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Tokens(tokens []store.APIToken, createdToken string, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("API Tokens", user, org, flash, "/settings/tokens", tokensContent(tokens, createdToken, errMsg))
}

templ tokensContent(tokens []store.APIToken, createdToken string, errMsg string) {
	<div class="space-y-6 max-w-3xl">
		<h1 class="text-xl font-semibold">API Tokens</h1>
		if createdToken != "" {
			<div role="status" class="space-y-2 rounded-box border border-success/30 bg-success/10 p-4">
				<p class="text-sm text-success font-semibold">Token created — save it now. It will not be shown again.</p>
				<code class="block font-mono text-xs text-success bg-base-200 p-3 rounded break-all">{ createdToken }</code>
			</div>
		}
		<section class="space-y-4 rounded-box bg-base-100 p-6 ring-1 ring-base-content/10">
			<h2 class="text-sm font-semibold text-base-content/80">Create token</h2>
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<form method="POST" action="/settings/tokens" class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div>
						<div><label for="tok-name" class="block text-sm font-medium">Name</label><input type="text" id="tok-name" name="name" required placeholder="CI deploy token" class="mt-2 block w-full rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
					</div>
					<div>
						<label for="tok-scopes">Scopes <span class="text-base-content/50 font-normal">(comma-separated)</span></label>
						<input type="text" id="tok-scopes" name="scopes" placeholder="deploy:app-id" class="mt-2 block w-full rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/>
					</div>
				</div>
				<button type="submit" class="rounded-field bg-primary px-4 py-2 text-sm font-semibold text-primary-content">Create token</button>
			</form>
		</section>
		if len(tokens) > 0 {
			<section class="rounded-box bg-base-100 p-6 ring-1 ring-base-content/10">
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="text-xs text-base-content/50 border-b border-base-300">
							<th class="text-left py-2">Name</th>
							<th class="text-left py-2">Scopes</th>
							<th class="text-left py-2">Last used</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-base-300">
						for _, t := range tokens {
							<tr class="text-base-content/80">
								<td class="py-2 text-sm">{ t.Name }</td>
								<td class="py-2 text-xs font-mono text-base-content/65">{ strings.Join(t.Scopes, ", ") }</td>
								<td class="py-2 text-xs text-base-content/50">
									if t.LastUsedAt != nil {
										{ relTimeSettings(*t.LastUsedAt) }
									} else {
										<span class="text-base-content/35">Never</span>
									}
								</td>
								<td class="py-2 text-right">
									<form method="POST" action={ templ.SafeURL("/settings/tokens/" + t.ID + "/revoke") } onsubmit="return confirm('Revoke this token?')">
										<button type="submit" class="rounded-field px-3 py-1.5 text-xs font-semibold text-error ring-1 ring-error/30 hover:bg-error/10">Revoke</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
	</div>
}
