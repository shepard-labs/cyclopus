package settings

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Registries(registries []store.Registry, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Registries", user, org, flash, "/settings/registries", registriesContent(registries, errMsg))
}

templ registriesContent(registries []store.Registry, errMsg string) {
	<div class="space-y-6 max-w-3xl">
		<h1 class="text-xl font-semibold">Container Registries</h1>
		<section class="space-y-4 rounded-box bg-base-100 p-6 ring-1 ring-base-content/10">
			<h2 class="text-sm font-semibold text-base-content/80">Add registry</h2>
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<form method="POST" action="/settings/registries" class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					@components.Select("reg-provider", "provider", "Provider", "ghcr", []components.SelectOption{{Value:"ghcr",Label:"GitHub Container Registry (ghcr)"},{Value:"gcr",Label:"Google Container Registry (gcr)"},{Value:"ecr",Label:"Amazon ECR (ecr)"},{Value:"other",Label:"Other"}}, true)
					<div>
						<div><label for="reg-url" class="block text-sm font-medium">Registry URL</label><input type="text" id="reg-url" name="registry_url" required placeholder="ghcr.io" class="mt-2 block w-full rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
					</div>
				</div>
				<div>
					<label for="reg-cred">Credential secret ref <span class="text-base-content/50 font-normal">(k8s-secret://…)</span></label>
					<input type="text" id="reg-cred" name="credential_secret_ref" required placeholder="k8s-secret://cyclopus/registry-cred#.dockerconfigjson" class="mt-2 block w-full rounded-field bg-base-100 px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/>
				</div>
				<button type="submit" class="rounded-field bg-primary px-4 py-2 text-sm font-semibold text-primary-content">Add registry</button>
			</form>
		</section>
		if len(registries) > 0 {
			<section class="rounded-box bg-base-100 p-6 ring-1 ring-base-content/10">
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="text-xs text-base-content/50 border-b border-base-300">
							<th class="text-left py-2">Provider</th>
							<th class="text-left py-2">URL</th>
							<th class="text-left py-2">Created</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-base-300">
						for _, r := range registries {
							<tr class="text-base-content/80">
								<td class="py-2 text-xs font-mono">{ r.Provider }</td>
								<td class="py-2 text-xs text-base-content/65 font-mono">{ r.RegistryURL }</td>
								<td class="py-2 text-xs text-base-content/50">{ relTimeSettings(r.CreatedAt) }</td>
								<td class="py-2 text-right">
									<form method="POST" action={ templ.SafeURL("/settings/registries/" + r.ID + "/delete") } onsubmit="return confirm('Delete this registry?')">
										<button type="submit" class="rounded-field px-3 py-1.5 text-xs font-semibold text-error ring-1 ring-error/30 hover:bg-error/10">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
	</div>
}
