package settings

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Registries(status store.Registry, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Registries", user, org, flash, "/settings/registries", registriesContent(status, errMsg))
}

templ registriesContent(status store.Registry, errMsg string) {
	<div class="w-full space-y-6">
		@components.SectionCard("GHCR credential status") {
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<div class="grid gap-4 sm:grid-cols-3">
				<div><div class="text-xs text-base-content/50">State</div><div class="mt-1 text-sm font-medium">{ status.State }</div></div>
				<div><div class="text-xs text-base-content/50">Active generation</div><div class="mt-1 text-sm font-medium">{ fmt.Sprint(status.ActiveGeneration) }</div></div>
				<div><div class="text-xs text-base-content/50">Credential</div><div class="mt-1 text-sm font-medium">
					if status.HasActiveCredential {
						Configured
					} else {
						Not configured
					}
				</div></div>
			</div>
			if status.HasPendingCredential || status.OperationID != nil {
				<div class="mt-4">@components.Alert("info", "Credential validation or namespace reconciliation is pending. This page shows only non-secret progress; refresh until the operation reaches ready or failed.")</div>
			}
			if status.FailureCode != nil {
				<div class="mt-4">@components.Alert("error", ghcrStatusGuidance(*status.FailureCode))</div>
			}
		}
		@components.SectionCard("Rotate GHCR credential") {
			if status.HasActiveCredential {
				<p class="mb-4 text-sm text-base-content/65">Enter a GitHub username and PAT classic with <code>read:packages</code>. Cyclopus validates the candidate against every referenced private image before activation and reconciles namespace pull Secrets asynchronously.</p>
				<form method="POST" action="/settings/registries/ghcr/rotate" class="space-y-4" autocomplete="off">
					<div class="grid gap-4 md:grid-cols-2">
						@components.FormField("ghcr-rotate-user", "ghcr_username", "GitHub username", "text", "", "octocat", true)
						@components.FormField("ghcr-rotate-pat", "ghcr_pat", "PAT classic", "password", "", "ghp_…", true)
					</div>
					<p class="text-xs text-base-content/55">Credential values are submitted once and are never rendered back, logged, or stored in PostgreSQL.</p>
					<div class="flex justify-end"><button type="submit" disabled?={ status.HasPendingCredential || status.OperationID != nil } class="rounded-field bg-primary px-5 py-2 text-sm font-medium text-primary-content disabled:opacity-50">Rotate credential</button></div>
				</form>
			} else {
				<p class="text-sm text-base-content/65">The first private GHCR credential is created during a private repository import. Start an import and provide the username and PAT there; later replacements use this rotation page.</p>
				<a href="/projects/import" class="mt-4 inline-flex rounded-field border border-line bg-base-300 px-4 py-2 text-sm font-medium">Import private repository</a>
			}
		}
	</div>
}

func ghcrStatusGuidance(code string) string {
	switch code {
	case "registry_auth_failed": return "The candidate credential could not read a required package. Re-enter a PAT classic with read:packages and retry rotation."
	case "image_pull_secret_reconcile_failed": return "The source credential is active, but one or more environment namespace copies are not ready. Keep this page open for retry status, then retry the affected deployment."
	case "registry_credential_retry": return "Credential activation was interrupted before completion. Re-enter the same credential and retry rotation."
	default: return "Credential reconciliation is partial or failed. Review the typed status, then retry rotation with a valid credential."
	}
}
