package settings

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Registries(registries []store.Registry, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Registries", user, org, flash, "/settings/registries", registriesContent(registries, errMsg))
}

templ registriesContent(registries []store.Registry, errMsg string) {
	<div class="w-full space-y-6">
		@components.SectionCard("GHCR credentials") {
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<p class="text-sm text-base-content/65">GHCR credential setup and rotation are not available in this phase. Current credential status is shown read-only.</p>
		}
		if len(registries) > 0 {
			@components.Card("") {
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="border-b border-line text-xs uppercase tracking-wider text-base-content/50">
							<th class="text-left py-2">Provider</th>
							<th class="text-left py-2">Status</th>
							<th class="text-left py-2">Credential</th>
							<th class="text-left py-2">Created</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, r := range registries {
							<tr class="bg-base-300/40 text-base-content/80">
								<td class="py-2 text-xs font-mono">{ r.Provider }</td>
								<td class="py-2 text-xs text-base-content/65">{ r.State }</td>
								<td class="py-2 text-xs text-base-content/65">
									if r.HasActiveCredential {
										Configured
									} else {
										Not configured
									}
								</td>
								<td class="py-2 text-xs text-base-content/50">{ relTimeSettings(r.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</div>
}
