package settings

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Webhooks(webhooks []store.Webhook, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Webhooks", user, org, flash, "/settings/webhooks", webhooksContent(webhooks, errMsg))
}

templ webhooksContent(webhooks []store.Webhook, errMsg string) {
	<div class="space-y-6 max-w-3xl">
		<h1 class="text-xl font-semibold">Webhooks</h1>
		<wa-card class="space-y-4">
			<h2 class="text-sm font-semibold text-base-content/80">Add endpoint</h2>
			if errMsg != "" {
				<wa-callout variant="danger">{ errMsg }</wa-callout>
			}
			<form method="POST" action="/settings/webhooks" class="space-y-4">
				<div class="fieldset">
					<wa-input type="url" id="wh-url" name="target_url" required placeholder="https://example.com/hooks/cyclopus" label="Target URL"></wa-input>
				</div>
				<div class="fieldset">
					<label for="wh-secret">Signing secret ref <span class="text-base-content/50 font-normal">(k8s-secret://…)</span></label>
					<wa-input type="text" id="wh-secret" name="secret_ref" required placeholder="k8s-secret://cyclopus/webhook-signing#value"></wa-input>
				</div>
				<div class="fieldset">
					<label for="wh-events">Events <span class="text-base-content/50 font-normal">(comma-separated, empty = all)</span></label>
					<wa-input type="text" id="wh-events" name="events" placeholder="deploy.succeeded,deploy.failed"></wa-input>
				</div>
				<wa-button type="submit" variant="brand">Add webhook</wa-button>
			</form>
		</wa-card>
		if len(webhooks) > 0 {
			<wa-card>
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="text-xs text-base-content/50 border-b border-base-300">
							<th class="text-left py-2">URL</th>
							<th class="text-left py-2">Status</th>
							<th class="text-left py-2">Failures</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-base-300">
						for _, w := range webhooks {
							<tr class="text-base-content/80">
								<td class="py-2 text-xs font-mono text-base-content/65 truncate max-w-xs">{ w.TargetURL }</td>
								<td class="py-2">
									if w.DisabledAt == nil {
										<wa-badge variant="success">Enabled</wa-badge>
									} else {
										<wa-badge variant="danger">Disabled</wa-badge>
									}
								</td>
								<td class="py-2 text-xs text-base-content/65">{ fmt.Sprintf("%d", w.ConsecutiveFailures) }</td>
								<td class="py-2 text-right">
									<form method="POST" action={ templ.SafeURL("/settings/webhooks/" + w.ID + "/delete") } onsubmit="return confirm('Delete this webhook?')">
										<wa-button type="submit" variant="danger" size="small">Delete</wa-button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</wa-card>
		}
	</div>
}
