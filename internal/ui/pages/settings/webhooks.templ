package settings

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Webhooks(webhooks []store.Webhook, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Webhooks", user, org, flash, "/settings/webhooks", webhooksContent(webhooks, errMsg))
}

templ webhooksContent(webhooks []store.Webhook, errMsg string) {
	<div class="space-y-6 max-w-3xl">
		<section class="space-y-4 rounded-box border border-line bg-base-200 p-6">
			<h2 class="text-sm font-semibold text-base-content/80">Add endpoint</h2>
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<form method="POST" action="/settings/webhooks" class="space-y-4">
				<div>
					<div><label for="wh-url" class="block text-xs font-medium">Target URL</label><input type="url" id="wh-url" name="target_url" required placeholder="https://example.com/hooks/cyclopus" class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/></div>
				</div>
				<div>
					<label for="wh-secret" class="block text-xs font-medium">Signing secret ref <span class="text-base-content/50 font-normal">(k8s-secret://…)</span></label>
					<input type="text" id="wh-secret" name="secret_ref" required placeholder="k8s-secret://cyclopus/webhook-signing#value" class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/>
				</div>
				<div>
					<label for="wh-events" class="block text-xs font-medium">Events <span class="text-base-content/50 font-normal">(comma-separated, empty = all)</span></label>
					<input type="text" id="wh-events" name="events" placeholder="deploy.succeeded,deploy.failed" class="mt-2 block w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary"/>
				</div>
				<button type="submit" class="rounded-field bg-primary px-4 py-2 text-sm font-medium text-primary-content">Add webhook</button>
			</form>
		</section>
		if len(webhooks) > 0 {
			<section class="rounded-box border border-line bg-base-200 p-6">
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="border-b border-line text-xs uppercase tracking-wider text-base-content/50">
							<th class="text-left py-2">URL</th>
							<th class="text-left py-2">Status</th>
							<th class="text-left py-2">Failures</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, w := range webhooks {
							<tr class="bg-base-300/40 text-base-content/80">
								<td class="py-2 text-xs font-mono text-base-content/65 truncate max-w-xs">{ w.TargetURL }</td>
								<td class="py-2">
									if w.DisabledAt == nil {
										@components.OperationalStatus("success", "Enabled")
									} else {
										@components.OperationalStatus("error", "Disabled")
									}
								</td>
								<td class="py-2 text-xs text-base-content/65">{ fmt.Sprintf("%d", w.ConsecutiveFailures) }</td>
								<td class="py-2 text-right">
									<form method="POST" action={ templ.SafeURL("/settings/webhooks/" + w.ID + "/delete") } onsubmit="return confirm('Delete this webhook?')">
									<button type="submit" class="rounded-field border border-error/30 px-3 py-2 text-sm font-medium text-base-content hover:bg-error/10">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
	</div>
}
