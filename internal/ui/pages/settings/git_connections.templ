package settings

import (
	"fmt"
	"github.com/cyclopus-dev/cyclopus/internal/ui"
	"github.com/cyclopus-dev/cyclopus/internal/ui/components"
)

templ GitConnections(connections []ui.GitConnection, user ui.User, org ui.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Git Connections", user, org, flash, "/settings/git-connections", gitConnectionsContent(connections, org, errMsg))
}

templ gitConnectionsContent(connections []ui.GitConnection, org ui.Organization, errMsg string) {
	<div class="space-y-6 max-w-3xl">
		<h1 class="text-xl font-semibold">Git Connections</h1>
		<div class="card space-y-4">
			<h2 class="text-sm font-semibold text-zinc-300">Add GitHub App connection</h2>
			if errMsg != "" {
				<div class="p-3 bg-red-500/20 border border-red-500/50 rounded text-sm text-red-400">{ errMsg }</div>
			}
			<form method="POST" action="/settings/git-connections" class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div class="input-group">
						<label for="gc-repo">Repository (owner/repo)</label>
						<input type="text" id="gc-repo" name="repo_full_name" required placeholder="acme/api"/>
					</div>
					<div class="input-group">
						<label for="gc-installation">GitHub App Installation ID</label>
						<input type="number" id="gc-installation" name="installation_id" required placeholder="12345678"/>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div class="input-group">
						<label for="gc-branch">Default branch</label>
						<input type="text" id="gc-branch" name="default_branch" value="main"/>
					</div>
					<div class="input-group">
						<label for="gc-secret">Webhook secret ref <span class="text-zinc-500 font-normal">(k8s-secret://…)</span></label>
						<input type="text" id="gc-secret" name="webhook_secret_ref" required placeholder="k8s-secret://cyclopus/webhook-secret#value"/>
					</div>
				</div>
				<button type="submit" class="btn btn-primary">Add connection</button>
			</form>
		</div>
		if len(connections) > 0 {
			<div class="card">
				<h2 class="text-sm font-semibold text-zinc-300 mb-4">Connections</h2>
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="text-xs text-zinc-500 border-b border-zinc-800">
							<th class="text-left py-2">Repository</th>
							<th class="text-left py-2">Branch</th>
							<th class="text-left py-2">Installation</th>
							<th class="text-left py-2">Created</th>
							<th class="text-right py-2">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-zinc-800">
						for _, gc := range connections {
							<tr class="text-zinc-300">
								<td class="py-2 font-mono text-xs">{ gc.RepoFullName }</td>
								<td class="py-2 text-xs text-zinc-400">{ gc.DefaultBranch }</td>
								<td class="py-2 text-xs text-zinc-400 font-mono">{ fmt.Sprintf("%d", gc.InstallationID) }</td>
								<td class="py-2 text-xs text-zinc-500">{ relTimeSettings(gc.CreatedAt) }</td>
								<td class="py-2 text-right">
									<form method="POST" action={ templ.SafeURL("/settings/git-connections/" + gc.ID + "/delete") } onsubmit="return confirm('Delete this connection?')">
										<button type="submit" class="btn btn-danger btn-sm">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
