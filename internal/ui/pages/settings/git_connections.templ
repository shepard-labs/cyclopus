package settings

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ GitConnections(connections []store.GitConnection, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Git Connections", user, org, flash, "/settings/git-connections", gitConnectionsContent(connections, errMsg))
}

templ gitConnectionsContent(connections []store.GitConnection, errMsg string) {
	<div class="w-full space-y-6">
		@components.SectionCard("GitHub App connections") {
			if errMsg != "" {
				@components.Alert("error", errMsg)
			}
			<p class="text-sm text-base-content/65">GitHub App setup and repository import are not available in this phase. Existing connection status is shown read-only.</p>
		}
		if len(connections) > 0 {
			@components.Card("Connections") {
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="border-b border-line text-xs uppercase tracking-wider text-base-content/50">
							<th class="text-left py-2">Status</th>
							<th class="text-left py-2">Access</th>
							<th class="text-left py-2">Created</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						for _, gc := range connections {
							<tr class="bg-base-300/40 text-base-content/80">
								<td class="py-2 text-xs text-base-content/65">{ gc.State }</td>
								<td class="py-2 text-xs text-base-content/65">{ gc.AccessState }</td>
								<td class="py-2 text-xs text-base-content/50">{ relTimeSettings(gc.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</div>
}
