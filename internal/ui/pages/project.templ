package pages

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ ProjectDetail(project store.Project, apps []store.App, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Project — "+project.Name, user, org, flash, "/projects", projectDetailContent(project, apps, errMsg))
}

templ projectDetailContent(project store.Project, apps []store.App, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center gap-2 text-sm text-base-content/65">
			<a href="/projects" class="hover:text-accent">Projects</a>
			<span>/</span>
			<span class="text-base-content">{ project.Name }</span>
		</div>
		<div class="flex items-center justify-between">
			<h1 class="text-xl font-semibold text-base-content">{ project.Name }</h1>
		</div>
		<wa-card>
			<h2 class="text-sm font-semibold text-base-content/80 mb-4">New application</h2>
			if errMsg != "" {
				<wa-callout variant="danger" class="mb-4">{ errMsg }</wa-callout>
			}
			<form method="POST" action={ templ.SafeURL("/projects/" + project.ID + "/apps") } class="space-y-3">
				<div class="grid grid-cols-2 gap-3">
					<div class="fieldset">
						<wa-input type="text" id="app-name" name="name" required placeholder="api" label="Name"></wa-input>
					</div>
					<div class="fieldset">
						<wa-input type="text" id="app-slug" name="slug" required placeholder="api" pattern="[a-z0-9-]+" label="Slug"></wa-input>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div class="fieldset">
						<wa-input type="text" id="app-hostname" name="hostname_label" required placeholder="api" pattern="[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?" label="Hostname label"></wa-input>
					</div>
					<div class="fieldset">
						<wa-input type="number" id="app-port" name="container_port" value="8080" min="1" max="65535" label="Container port"></wa-input>
					</div>
				</div>
				<wa-button type="submit" variant="brand" appearance="accent">Create application</wa-button>
			</form>
		</wa-card>
		if len(apps) == 0 {
			<wa-card class="text-center py-12">
				<p class="text-base-content/65 text-sm">No applications yet. Create one above.</p>
			</wa-card>
		} else {
			<div class="grid grid-cols-1 gap-3">
				for _, a := range apps {
					<a href={ templ.SafeURL("/apps/" + a.ID) } class="link-card flex items-center justify-between hover:border-base-content/30 transition-colors group">
						<div class="flex items-center gap-3 min-w-0">
							<div class="min-w-0">
								<div class="font-medium text-base-content group-hover:text-accent transition-colors">{ a.Name }</div>
								<div class="text-xs text-base-content/50 mt-0.5 font-mono">{ a.HostnameLabel }</div>
							</div>
							@components.RuntimeClassBadge(a.RuntimeClass)
						</div>
						<div class="flex items-center gap-2 text-base-content/65">
							<span class="text-xs">{ fmt.Sprintf(":%d", a.ContainerPort) }</span>
							<wa-icon name="chevron-right" class="w-4 h-4 text-base-content/35 group-hover:text-base-content/65" aria-hidden="true"></wa-icon>
						</div>
					</a>
				}
			</div>
		}
	</div>
}
