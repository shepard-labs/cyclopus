package pages

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ ProjectDetail(project store.Project, apps []store.App, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Project — "+project.Name, user, org, flash, "/projects", projectDetailContent(project, apps, errMsg))
}

templ projectDetailContent(project store.Project, apps []store.App, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center gap-2 text-xs text-base-content/65">
			<a href="/projects" class="hover:text-accent">Projects</a>
			<span>/</span>
			<span class="text-base-content">{ project.Name }</span>
		</div>
		<div class="flex items-center justify-between">
			<h1 class="text-lg/7 font-semibold text-base-content">{ project.Name }</h1>
		</div>
		<div class="rounded-box border border-line bg-base-200 p-6">
			<h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/80 mb-4">New application</h2>
			if errMsg != "" {
				<div class="mb-4">@components.Alert("error", errMsg)</div>
			}
			<form method="POST" action={ templ.SafeURL("/projects/" + project.ID + "/apps") } class="space-y-3">
				<div class="grid grid-cols-2 gap-3">
					<div><label for="app-name" class="block text-xs font-medium">Name</label><input type="text" id="app-name" name="name" required placeholder="api" class="mt-2 w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm"/></div>
					<div><label for="app-slug" class="block text-xs font-medium">Slug</label><input type="text" id="app-slug" name="slug" required placeholder="api" pattern="[a-z0-9-]+" class="mt-2 w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm"/></div>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div><label for="app-hostname" class="block text-xs font-medium">Hostname label</label><input type="text" id="app-hostname" name="hostname_label" required placeholder="api" pattern="[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?" class="mt-2 w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm"/></div>
					<div><label for="app-port" class="block text-xs font-medium">Container port</label><input type="number" id="app-port" name="container_port" value="8080" min="1" max="65535" class="mt-2 w-full rounded-field border border-line bg-base-300 px-3 py-2 text-sm"/></div>
				</div>
				<button type="submit" class="rounded-field bg-primary px-4 py-2 text-sm font-medium text-primary-content">Create application</button>
			</form>
		</div>
		if len(apps) == 0 {
			@components.EmptyState("No applications yet", "Create your first application above.")
		} else {
			<div class="grid grid-cols-1 gap-3">
				for _, a := range apps {
					<a href={ templ.SafeURL("/apps/" + a.ID) } class="group flex items-center justify-between rounded-box border border-line bg-base-200 p-5 transition hover:bg-base-300">
						<div class="flex items-center gap-3 min-w-0">
							<div class="min-w-0">
								<div class="text-sm font-medium text-base-content group-hover:text-accent transition-colors">{ a.Name }</div>
								<div class="text-xs text-base-content/50 mt-0.5 font-mono">{ a.HostnameLabel }</div>
							</div>
							@components.RuntimeClassBadge(a.RuntimeClass)
						</div>
						<div class="flex items-center gap-2 text-base-content/65">
							<span class="text-xs">{ fmt.Sprintf(":%d", a.ContainerPort) }</span>
							@components.IconChevronRight("size-4 text-base-content/40")
						</div>
					</a>
				}
			</div>
		}
	</div>
}
