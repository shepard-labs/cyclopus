package pages

import (
	"fmt"
	"github.com/cyclopus-dev/cyclopus/internal/ui"
	"github.com/cyclopus-dev/cyclopus/internal/ui/components"
)

templ ProjectDetail(project ui.Project, apps []ui.Application, user ui.User, org ui.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Project — "+project.Name, user, org, flash, "/projects", projectDetailContent(project, apps, errMsg))
}

templ projectDetailContent(project ui.Project, apps []ui.Application, errMsg string) {
	<div class="space-y-6">
		<div class="flex items-center gap-2 text-sm text-zinc-400">
			<a href="/projects" class="hover:text-violet-300">Projects</a>
			<span>/</span>
			<span class="text-zinc-100">{ project.Name }</span>
		</div>
		<div class="flex items-center justify-between">
			<h1 class="text-xl font-semibold text-zinc-100">{ project.Name }</h1>
		</div>
		<div class="card">
			<h2 class="text-sm font-semibold text-zinc-300 mb-4">New application</h2>
			if errMsg != "" {
				<div class="flex items-center gap-2 p-3 mb-4 bg-red-500/20 border border-red-500/50 rounded text-sm text-red-400">{ errMsg }</div>
			}
			<form method="POST" action={ templ.SafeURL("/projects/" + project.ID + "/apps") } class="space-y-3">
				<div class="grid grid-cols-2 gap-3">
					<div class="input-group">
						<label for="app-name">Name</label>
						<input type="text" id="app-name" name="name" required placeholder="api"/>
					</div>
					<div class="input-group">
						<label for="app-slug">Slug</label>
						<input type="text" id="app-slug" name="slug" required placeholder="api" pattern="[a-z0-9-]+"/>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div class="input-group">
						<label for="app-hostname">Hostname label</label>
						<input type="text" id="app-hostname" name="hostname_label" required placeholder="api" pattern="[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?"/>
					</div>
					<div class="input-group">
						<label for="app-port">Container port</label>
						<input type="number" id="app-port" name="container_port" value="8080" min="1" max="65535"/>
					</div>
				</div>
				<button type="submit" class="btn btn-primary">Create application</button>
			</form>
		</div>
		if len(apps) == 0 {
			<div class="card text-center py-12">
				<p class="text-zinc-400 text-sm">No applications yet. Create one above.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-3">
				for _, a := range apps {
					<a href={ templ.SafeURL("/apps/" + a.ID) } class="card flex items-center justify-between hover:border-zinc-600 transition-colors group">
						<div class="flex items-center gap-3 min-w-0">
							<div class="min-w-0">
								<div class="font-medium text-zinc-100 group-hover:text-violet-300 transition-colors">{ a.Name }</div>
								<div class="text-xs text-zinc-500 mt-0.5 font-mono">{ a.HostnameLabel }</div>
							</div>
							@components.RuntimeClassBadge(a.RuntimeClass)
						</div>
						<div class="flex items-center gap-2 text-zinc-400">
							<span class="text-xs">{ fmt.Sprintf(":%d", a.ContainerPort) }</span>
							<svg class="w-4 h-4 text-zinc-600 group-hover:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
						</div>
					</a>
				}
			</div>
		}
	</div>
}
