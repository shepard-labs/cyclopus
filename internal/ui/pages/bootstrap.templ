package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Bootstrap(errMsg string) {
	@components.AuthPage("Claim install") {
		<div class="w-full max-w-sm">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 mb-4">
					<svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
					<span class="text-2xl font-bold">Cyclopus</span>
				</div>
				<h1 class="text-xl font-semibold text-base-content">Claim your Cyclopus install</h1>
				<p class="mt-2 text-sm text-base-content/65">Create the first administrator account.</p>
			</div>
			<div class="card">
				if errMsg != "" {
					<div class="alert alert-error mb-4">
						{ errMsg }
					</div>
				}
				<form method="POST" action="/bootstrap" class="space-y-4">
					<div class="fieldset">
						<label for="email">Email address</label>
						<input type="email" id="email" name="email" required placeholder="admin@example.com"/>
					</div>
					<div class="fieldset">
						<label for="password">Password</label>
						<input type="password" id="password" name="password" required placeholder="••••••••" minlength="8"/>
					</div>
					<div class="fieldset">
						<label for="bootstrap_token">Bootstrap token</label>
						<input type="password" id="bootstrap_token" name="bootstrap_token" required placeholder="Value of CYCLOPUS_AUTH_BOOTSTRAP_SECRET"/>
						<span class="text-xs text-base-content/50 mt-1">Must match the <code class="text-base-content/65">CYCLOPUS_AUTH_BOOTSTRAP_SECRET</code> the server was started with.</span>
					</div>
					<button type="submit" class="btn btn-primary w-full justify-center mt-2">Create account</button>
				</form>
			</div>
		</div>
	}
}
