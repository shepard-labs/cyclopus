package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Bootstrap(errMsg string) {
	@components.AuthPage("Claim install") {
		<div class="w-full max-w-sm">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 mb-4">
					<wa-icon name="circle-info" class="w-8 h-8 text-primary" aria-hidden="true"></wa-icon>
					<span class="text-2xl font-bold">Cyclopus</span>
				</div>
				<h1 class="text-xl font-semibold text-base-content">Claim your Cyclopus install</h1>
				<p class="mt-2 text-sm text-base-content/65">Create the first administrator account.</p>
			</div>
			<wa-card>
				if errMsg != "" {
					<wa-callout variant="danger" class="mb-4">
						{ errMsg }
					</wa-callout>
				}
				<form method="POST" action="/bootstrap" class="space-y-4">
					<div class="fieldset">
						<wa-input type="email" id="email" name="email" required placeholder="admin@example.com" label="Email address"></wa-input>
					</div>
					<div class="fieldset">
						<wa-input type="password" id="password" name="password" required placeholder="••••••••" minlength="8" label="Password"></wa-input>
					</div>
					<div class="fieldset">
						<wa-input type="password" id="bootstrap_token" name="bootstrap_token" required placeholder="Value of CYCLOPUS_AUTH_BOOTSTRAP_SECRET" label="Bootstrap token"></wa-input>
						<span class="text-xs text-base-content/50 mt-1">Must match the <code class="text-base-content/65">CYCLOPUS_AUTH_BOOTSTRAP_SECRET</code> the server was started with.</span>
					</div>
					<wa-button type="submit" variant="brand" class="w-full mt-2">Create account</wa-button>
				</form>
			</wa-card>
		</div>
	}
}
