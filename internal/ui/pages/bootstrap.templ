package pages

import "github.com/shepard-labs/cyclopus/internal/ui/components"

templ Bootstrap(errMsg string) {
	@components.AuthPage("Claim install") {
		<div class="w-full max-w-sm">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 mb-4">
					@components.IconLogo("size-8 text-primary")
					<span class="text-2xl font-bold">Cyclopus</span>
				</div>
				<h1 class="text-xl font-semibold text-base-content">Claim your Cyclopus install</h1>
				<p class="mt-2 text-sm text-base-content/65">Create the first administrator account.</p>
			</div>
			<div class="rounded-box bg-base-100 p-6 shadow-theme ring-1 ring-base-content/10">
				if errMsg != "" {
					<div class="mb-4">@components.Alert("error", errMsg)</div>
				}
				<form method="POST" action="/bootstrap" class="space-y-4">
					<div><label for="email" class="block text-sm font-medium">Email address</label><input type="email" id="email" name="email" required placeholder="admin@example.com" class="mt-2 block w-full rounded-field px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
					<div><label for="password" class="block text-sm font-medium">Password</label><input type="password" id="password" name="password" required placeholder="••••••••" minlength="8" class="mt-2 block w-full rounded-field px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/></div>
					<div><label for="bootstrap_token" class="block text-sm font-medium">Bootstrap token</label><input type="password" id="bootstrap_token" name="bootstrap_token" required placeholder="Value of CYCLOPUS_AUTH_BOOTSTRAP_SECRET" class="mt-2 block w-full rounded-field px-3 py-2 text-sm ring-1 ring-base-content/20 outline-none focus:ring-2 focus:ring-primary"/>
						<span class="text-xs text-base-content/50 mt-1">Must match the <code class="text-base-content/65">CYCLOPUS_AUTH_BOOTSTRAP_SECRET</code> the server was started with.</span>
					</div>
					<button type="submit" class="mt-2 w-full rounded-field bg-primary px-3 py-2 text-sm font-semibold text-primary-content">Create account</button>
				</form>
			</div>
		</div>
	}
}
