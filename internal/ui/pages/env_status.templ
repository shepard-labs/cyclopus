package pages

import (
	"github.com/cyclopus-dev/cyclopus/internal/ui"
	"github.com/cyclopus-dev/cyclopus/internal/ui/components"
)

// EnvStatusFragment is the HTMX polling fragment for the production deploy card.
// When no deploy is in progress it returns a static element that stops polling.
templ EnvStatusFragment(env ui.Environment, alias *ui.Alias, release *ui.Release) {
	if env.InProgressReleaseID != "" {
		<div
			id="prod-status"
			class="flex items-center gap-2 p-3 bg-blue-500/20 rounded text-sm text-blue-400 animate-pulse"
			hx-get={ "/environments/" + env.ID + "/status-fragment" }
			hx-trigger="every 3s"
			hx-swap="outerHTML"
			hx-target="#prod-status"
		>
			<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.22-8.56"></path></svg>
			Deploy in progress…
		</div>
	} else {
		<div id="prod-status" class="space-y-3">
			if alias != nil && alias.Hostname != "" {
				<div class="flex items-center justify-between">
					<span class="text-xs text-zinc-500">Hostname</span>
					<a href={ templ.SafeURL("https://" + alias.Hostname) } target="_blank" rel="noopener" class="text-sm font-mono text-violet-400 hover:text-violet-300">{ alias.Hostname } ↗</a>
				</div>
			}
			if release != nil {
				<div class="flex items-center justify-between">
					<span class="text-xs text-zinc-500">Current release</span>
					@components.ReleaseStatusBadge(release.Status)
				</div>
			}
		</div>
	}
}
