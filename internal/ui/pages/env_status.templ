package pages

import (
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

// EnvStatusFragment is the HTMX polling fragment for the production deploy card.
// When no deploy is in progress it returns a static element that stops polling.
templ EnvStatusFragment(env store.Environment, alias *store.Alias, release *store.Release) {
	if env.InProgressReleaseID != nil {
		<wa-callout
			id="prod-status"
			variant="brand"
			class="animate-pulse"
			hx-get={ "/environments/" + env.ID + "/status-fragment" }
			hx-trigger="every 3s"
			hx-swap="outerHTML"
			hx-target="#prod-status"
		>
			<wa-icon name="rotate" class="w-4 h-4 animate-spin" aria-hidden="true"></wa-icon>
			Deploy in progress…
		</wa-callout>
	} else {
		<div id="prod-status" class="space-y-3">
			if alias != nil && alias.Hostname != "" {
				<div class="flex items-center justify-between">
					<span class="text-xs text-base-content/50">Hostname</span>
					<a href={ templ.SafeURL("https://" + alias.Hostname) } target="_blank" rel="noopener" class="text-sm font-mono text-primary hover:text-accent">{ alias.Hostname } ↗</a>
				</div>
			}
			if release != nil {
				<div class="flex items-center justify-between">
					<span class="text-xs text-base-content/50">Current release</span>
					@components.ReleaseStatusBadge(release.Status)
				</div>
			}
		</div>
	}
}
