package admin

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Reconcile(runs []store.ReconciliationRun, user store.User, org store.Organization, flash *ui.FlashMessage) {
	@components.Page("Reconcile", user, org, flash, "/admin/reconcile", reconcileContent(runs, org))
}

templ reconcileContent(runs []store.ReconciliationRun, org store.Organization) {
	<div class="space-y-6 max-w-4xl">
		<div>
			<h1 class="text-xl font-semibold">Reconciliation</h1>
			<p class="text-sm text-base-content/65 mt-1">Regenerate Kubernetes objects from Postgres state. Dry-run is the default.</p>
		</div>
		<div class="card space-y-4">
			<h2 class="text-sm font-semibold text-base-content/80">Start reconciliation</h2>
			<form method="POST" action="/admin/reconcile" class="flex items-center gap-4">
				<div class="flex items-center gap-2">
					<input type="checkbox" id="dry-run" name="dry_run" value="true" checked/>
					<label for="dry-run" class="text-sm font-normal text-base-content/80">Dry run <span class="text-base-content/50">(report changes without applying)</span></label>
				</div>
				<div class="flex items-center gap-2">
					<input type="checkbox" id="prune" name="prune" value="true"/>
					<label for="prune" class="text-sm font-normal text-base-content/80">Prune orphaned objects</label>
				</div>
				<button type="submit" class="btn btn-primary">Run reconciliation</button>
			</form>
		</div>
		<div class="card">
			<h2 class="text-sm font-semibold text-base-content/80 mb-4">Recent runs</h2>
			if len(runs) == 0 {
				<p class="text-sm text-base-content/65">No reconciliation runs yet.</p>
			} else {
				<table class="table-auto w-full text-sm">
					<thead>
						<tr class="text-xs text-base-content/50 border-b border-base-300">
							<th class="text-left py-2 pr-4">ID</th>
							<th class="text-left py-2 pr-4">Status</th>
							<th class="text-left py-2 pr-4">Scope</th>
							<th class="text-left py-2 pr-4">Dry run</th>
							<th class="text-left py-2 pr-4">Findings</th>
							<th class="text-left py-2">Started</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-base-300">
						for _, r := range runs {
							<tr class="text-base-content/80">
								<td class="py-2 pr-4 font-mono text-xs text-base-content/65">{ r.ID[:8] }</td>
								<td class="py-2 pr-4">@components.OperationStatusBadge(r.Status)</td>
								<td class="py-2 pr-4 text-xs text-base-content/65">{ r.ScopeKind }</td>
								<td class="py-2 pr-4 text-xs">
									if r.DryRun {
										<span class="badge badge-soft badge-warning">Dry run</span>
									} else {
										<span class="badge badge-soft badge-primary">Applied</span>
									}
								</td>
								<td class="py-2 pr-4 text-xs text-base-content/65">{ fmt.Sprintf("%d", findingCount(r.Report)) }</td>
								<td class="py-2 text-xs text-base-content/50">{ relTimeAdmin(r.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
}
