package admin

import (
	"fmt"
	"net/url"

	"github.com/shepard-labs/cyclopus/internal/adapters/observability"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ Metrics(nodes []observability.NodeSystemDetail, selectedNodeID string, errMessage string, user store.User, org store.Organization, flash *ui.FlashMessage) {
	@components.PageWide("Metrics", user, org, flash, "/admin/metrics", nil, metricsContent(nodes, selectedNodeID, errMessage))
}

templ MetricsFragment(nodes []observability.NodeSystemDetail, selectedNodeID string, errMessage string) {
	{{ id := resolveNodeID(nodes, selectedNodeID) }}
	<div id="metrics-container" hx-get={ metricsFragmentURL(id) } hx-trigger="every 10s" hx-swap="outerHTML settle:0s swap:0s transition:false">
		@metricsGrid(nodes, id, errMessage)
	</div>
}

templ metricsContent(nodes []observability.NodeSystemDetail, selectedNodeID string, errMessage string) {
	<style>
		#metrics-container.htmx-swapping,
		#metrics-container.htmx-settling {
			opacity: 1 !important;
			transition: none !important;
		}
	</style>
	<div class="w-full space-y-6">
		<div class="flex items-center justify-end">
			<span class="inline-flex items-center gap-1.5 text-xs text-base-content/60">
				<span class="size-2 rounded-full bg-success animate-pulse"></span>
				Auto-refreshes every 10s
			</span>
		</div>

		@MetricsFragment(nodes, selectedNodeID, errMessage)
	</div>

	<script>
		function formatUserLocalTime(isoStr) {
			if (!isoStr) return "";
			try {
				const d = new Date(isoStr);
				if (isNaN(d.getTime())) return isoStr;
				return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + " " +
					d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
			} catch (e) {
				return isoStr;
			}
		}

		function formatUserLocalTimeOnly(isoStr) {
			if (!isoStr) return "";
			try {
				const d = new Date(isoStr);
				if (isNaN(d.getTime())) return isoStr;
				return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
			} catch (e) {
				return isoStr;
			}
		}

		function initChartInteractions(root) {
			const scope = root || document;
			scope.querySelectorAll('.metric-chart-card').forEach(card => {
				const svg = card.querySelector('svg.metric-chart-svg');
				const crosshair = card.querySelector('.metric-crosshair');
				const tooltip = card.querySelector('.metric-tooltip');
				const currentValEl = card.querySelector('.metric-current-val');
				const rawPayload = card.getAttribute('data-chart-payload');
				if (!rawPayload || !svg || !crosshair || !tooltip) return;

				let data = null;
				try {
					data = JSON.parse(rawPayload);
				} catch (e) {
					console.error("JSON parse failed", e);
					return;
				}
				if (!data || !data.times || data.times.length === 0) return;

				card.querySelectorAll('.metric-time-tick').forEach(el => {
					const iso = el.getAttribute('data-iso-time');
					if (iso) el.textContent = formatUserLocalTimeOnly(iso);
				});

				const defaultVal = currentValEl ? currentValEl.textContent : '';

				card.onmousemove = function(e) {
					const rect = svg.getBoundingClientRect();
					if (rect.width <= 0) return;
					if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
						crosshair.style.display = 'none';
						tooltip.style.display = 'none';
						if (currentValEl) currentValEl.textContent = defaultVal;
						return;
					}

					const mouseX = Math.max(0, Math.min(e.clientX - rect.left, rect.width));
					const ratio = mouseX / rect.width;
					const n = data.times.length;
					const idx = Math.min(n - 1, Math.max(0, Math.round(ratio * (n - 1))));

					// SVG coordinate system is viewBox 0 0 300 80
					const svgX = (idx / (n === 1 ? 1 : n - 1)) * 300;
					crosshair.setAttribute('x1', svgX.toFixed(1));
					crosshair.setAttribute('x2', svgX.toFixed(1));
					crosshair.style.display = 'block';

					// Update tooltip content
					const timeStr = formatUserLocalTime(data.times[idx]);
					let valHtml = '<div class="font-mono text-xs font-semibold text-base-content/90 mb-1 border-b border-line pb-1">' + timeStr + '</div>';
					if (data.series && Array.isArray(data.series)) {
						data.series.forEach(s => {
							const val = (s.values && s.values[idx] !== undefined) ? Number(s.values[idx]).toFixed(2) : '-';
							valHtml += '<div class="flex items-center justify-between gap-3 text-xs py-0.5">' +
								'<span class="inline-flex items-center gap-1.5 text-base-content/70">' +
								'<span class="size-1.5 rounded-full inline-block" style="background-color: ' + s.color + '"></span>' +
								s.name +
								'</span>' +
								'<span class="font-mono font-medium text-base-content">' + val + ' ' + (data.unit || '') + '</span>' +
								'</div>';
						});
					}

					tooltip.innerHTML = valHtml;
					tooltip.style.display = 'block';

					// Calculate pixel X relative to container width
					const pxX = (svgX / 300) * rect.width;
					// Clamp tooltip within container boundaries
					const tooltipWidth = tooltip.offsetWidth || 140;
					const halfW = tooltipWidth / 2;
					const clampedPx = Math.max(halfW + 4, Math.min(rect.width - halfW - 4, pxX));
					tooltip.style.left = clampedPx + 'px';
					tooltip.style.top = '0px';
				};

				card.onmouseleave = function() {
					crosshair.style.display = 'none';
					tooltip.style.display = 'none';
					if (currentValEl) currentValEl.textContent = defaultVal;
				};
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => initChartInteractions(document));
		} else {
			initChartInteractions(document);
		}
		document.addEventListener('htmx:load', (e) => initChartInteractions(e.detail?.elt || e.target || document));
		document.addEventListener('htmx:afterRequest', (e) => {
			const elt = e.detail && e.detail.elt;
			if (!elt || elt.id !== 'metrics-node' || !e.detail.successful) return;
			const nodeId = elt.value;
			if (!nodeId) return;
			const url = new URL(window.location.href);
			url.searchParams.set('node', nodeId);
			url.searchParams.delete('fragment');
			history.replaceState(null, '', url.pathname + url.search);
		});
	</script>
}

templ metricsGrid(nodes []observability.NodeSystemDetail, selectedNodeID string, errMessage string) {
	if errMessage != "" {
		<div class="rounded-box border border-warning/30 bg-warning/10 p-4 text-sm text-base-content">
			<p class="font-medium text-warning">Metrics unavailable</p>
			<p class="mt-1 text-xs text-base-content/70">{ errMessage }</p>
		</div>
	}

	if len(nodes) == 0 && errMessage == "" {
		@components.Card("Host Systems") {
			<div class="py-8 text-center">
				<p class="text-sm font-medium text-base-content/80">No registered nodes reporting metrics</p>
				<p class="mt-1 text-xs text-base-content/60">Ensure beszel-agent is running and cluster nodes are registered with the Beszel hub.</p>
			</div>
		}
	} else if len(nodes) > 0 {
		<!-- Top Stat Overview Cards -->
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
			<div class="rounded-box border border-line bg-base-200 p-5">
				<div class="text-xs font-medium uppercase tracking-wider text-base-content/50">Nodes Online</div>
				<div class="mt-2 flex items-baseline gap-2">
					<span class="text-xl font-bold text-base-content">{ fmt.Sprintf("%d", len(nodes)) }</span>
					<span class="text-xs text-success font-medium">Reporting</span>
				</div>
			</div>
			<div class="rounded-box border border-line bg-base-200 p-5">
				<div class="text-xs font-medium uppercase tracking-wider text-base-content/50">Avg CPU Usage</div>
				<div class="mt-2 flex items-baseline gap-2">
					<span class="text-xl font-bold text-base-content">{ fmt.Sprintf("%.1f%%", avgCPUNodes(nodes)) }</span>
				</div>
			</div>
			<div class="rounded-box border border-line bg-base-200 p-5">
				<div class="text-xs font-medium uppercase tracking-wider text-base-content/50">Avg Memory Usage</div>
				<div class="mt-2 flex items-baseline gap-2">
					<span class="text-xl font-bold text-base-content">{ fmt.Sprintf("%.1f%%", avgMemoryNodes(nodes)) }</span>
				</div>
			</div>
			<div class="rounded-box border border-line bg-base-200 p-5">
				<div class="text-xs font-medium uppercase tracking-wider text-base-content/50">Avg Disk Usage</div>
				<div class="mt-2 flex items-baseline gap-2">
					<span class="text-xl font-bold text-base-content">{ fmt.Sprintf("%.1f%%", avgDiskNodes(nodes)) }</span>
				</div>
			</div>
		</div>

		<!-- Selected-node dashboard -->
		<div class="space-y-4 pt-4">
			{{ node, ok := selectedNode(nodes, selectedNodeID) }}
			if ok {
				{{ cpu, mem, disk, diskIO, net, load, temp := extractNodeChartData(node) }}
				{{ uptime := formatNodeUptime(node.UptimeSec) }}
				<div class="rounded-box border border-line bg-base-200 p-6 space-y-3">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
						<div>
							<label id="metrics-node-label" for="metrics-node" class="sr-only">Node</label>
							<el-select
								id="metrics-node"
								name="node"
								value={ node.ID }
								aria-labelledby="metrics-node-label"
								hx-get="/admin/metrics?fragment=true"
								hx-target="#metrics-container"
								hx-swap="outerHTML settle:0s swap:0s transition:false"
								hx-trigger="change"
								hx-vals={ metricsNodeSelectVals }
								class="relative block w-52"
							>
								<button id="metrics-node-trigger" type="button" aria-haspopup="listbox" aria-controls="metrics-node-options" aria-labelledby="metrics-node-label metrics-node-selected" class="grid w-full cursor-pointer grid-cols-1 rounded-field border border-line bg-base-300 py-2 pr-10 pl-3 text-left text-sm font-medium text-base-content outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary">
									<el-selectedcontent id="metrics-node-selected" class="col-start-1 row-start-1 truncate">{ node.Name }</el-selectedcontent>
									@components.IconChevronDown("pointer-events-none col-start-1 row-start-1 size-4 self-center justify-self-end text-base-content/50")
								</button>
								<el-options id="metrics-node-options" role="listbox" anchor="bottom start" popover class="max-h-60 w-(--button-width) overflow-auto rounded-box border border-line bg-base-300 p-1 shadow-theme transition transition-discrete data-closed:scale-95 data-closed:opacity-0">
									for _, option := range nodes {
										<el-option value={ option.ID } class="group/option relative flex cursor-default select-none items-center rounded-field px-3 py-2 text-sm font-medium text-base-content/75 focus:bg-primary focus:text-primary-content aria-selected:font-medium">
											<span class="block flex-1 truncate">{ option.Name }</span>
											<span class="ml-3 hidden group-aria-selected/option:block in-[el-selectedcontent]:hidden">@components.IconCheck("size-4")</span>
										</el-option>
									}
								</el-options>
							</el-select>
						</div>
						if uptime != "" {
							<span class="text-xs text-base-content/65">{ uptime }</span>
						}
						if node.OS != "" {
							<span class="text-xs text-base-content/65">{ node.OS }</span>
						}
						if node.CPUModel != "" {
							<span class="text-xs text-base-content/65">{ node.CPUModel }</span>
						}
					</div>
					<div class="flex flex-wrap items-center gap-3">
						<span class="inline-flex items-center rounded-md border border-line bg-base-300 px-2 py-0.5 font-mono text-xs font-medium text-base-content/80">{ node.Host }</span>
						if node.Port != "" {
							<span class="inline-flex items-center rounded-md border border-line bg-base-300 px-2 py-0.5 font-mono text-xs font-medium text-base-content/80">{ node.Port }</span>
						}
						if node.Status == "up" || node.Status == "online" {
							@components.OperationalStatus("success", "Online")
						} else {
							@components.OperationalStatus("warning", node.Status)
						}
					</div>
				</div>

				@RenderSVGChart(cpu)
				@RenderSVGChart(mem)
				@RenderSVGChart(disk)
				@RenderSVGChart(diskIO)
				@RenderSVGChart(net)
				@RenderSVGChart(load)
				if temp.CurrentVal != "0.0 °C" && temp.CurrentVal != "0" {
					@RenderSVGChart(temp)
				}
			}
		</div>
	}
}

templ RenderSVGChart(chart SVGChartData) {
	<div class="metric-chart-card relative rounded-box border border-line bg-base-200 p-6 flex flex-col justify-between" data-chart={ chart.Title } data-chart-payload={ chart.DataJSON }>
		<div class="flex items-center justify-between mb-3">
			<div>
				<div class="text-xs font-semibold text-base-content/85">{ chart.Title }</div>
				if len(chart.Series) > 0 {
					<div class="flex items-center gap-2 mt-1">
						for _, s := range chart.Series {
							<span class="inline-flex items-center gap-1 text-xs text-base-content/60">
								<span class="size-1.5 rounded-full" style={ fmt.Sprintf("background-color: %s", s.Color) }></span>
								{ s.Name }
							</span>
						}
					</div>
				}
			</div>
		</div>

		<div class="flex w-full">
			<!-- Y axis ticks -->
			<div class="relative w-14 shrink-0 h-48 pt-1">
				if len(chart.YTicks) > 0 {
					for _, t := range chart.YTicks {
						<span class="absolute right-1 -translate-y-1/2 text-xs font-mono text-base-content/45 whitespace-nowrap" style={ fmt.Sprintf("top: %.1f%%", tickTopPct(chart.MinVal, chart.MaxVal, t)) }>{ formatTickValue(t, chart.Unit) }</span>
					}
				}
			</div>
			<div class="relative flex-1 h-48 cursor-crosshair">
				<!-- Floating Hover Tooltip -->
				<div style="display: none;" class="metric-tooltip pointer-events-none absolute z-30 -translate-x-1/2 -translate-y-full mb-1 rounded-box border border-line bg-base-200/95 backdrop-blur px-3 py-2 shadow-lg min-w-36"></div>

				<svg viewBox="0 0 300 80" preserveAspectRatio="none" class="metric-chart-svg w-full h-full overflow-visible pt-1 box-border">
					<defs>
						if chart.FillColor != "" {
							<linearGradient id={ "grad-" + chart.ID } x1="0" y1="0" x2="0" y2="1">
								<stop offset="0%" stop-color={ chart.FillColor } stop-opacity="0.28"></stop>
								<stop offset="100%" stop-color={ chart.FillColor } stop-opacity="0.0"></stop>
							</linearGradient>
						}
					</defs>

					<!-- Y tick gridlines -->
					if len(chart.YTicks) > 0 {
						for _, t := range chart.YTicks {
							{{ gy := 80.0 - 8.0 }}
							{{ ratio := (t - chart.MinVal) / (chart.MaxVal - chart.MinVal) }}
							if ratio >= 0 && ratio <= 1 {
								{{ gy = 80.0 - 8.0 - ratio*64.0 }}
								<line x1="0" y1={ fmt.Sprintf("%.1f", gy) } x2="300" y2={ fmt.Sprintf("%.1f", gy) } stroke="var(--tw-color-line)" stroke-width="0.75"></line>
							}
						}
					}

					<!-- Area fill -->
					if chart.AreaPath != "" {
						<path d={ chart.AreaPath } fill={ fmt.Sprintf("url(#grad-%s)", chart.ID) }></path>
					}

					<!-- Lines with consistent stroke-width vector effect -->
					for i, path := range chart.LinePaths {
						{{ stroke := chart.StrokeColor }}
						if len(chart.Series) > i && chart.Series[i].Color != "" {
							{{ stroke = chart.Series[i].Color }}
						}
						<path d={ path } fill="none" stroke={ stroke } stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"></path>
					}

					<!-- Interactive Crosshair -->
					<line style="display: none;" class="metric-crosshair" x1="0" y1="0" x2="0" y2="80" stroke="var(--tw-color-primary)" stroke-width="1.5" vector-effect="non-scaling-stroke"></line>
				</svg>

				<!-- X axis ticks (times filled client-side) -->
				<div class="absolute inset-x-0 top-full pt-1 flex">
					if len(chart.XTicks) > 0 {
						for _, idx := range chart.XTicks {
							<span class="metric-time-tick absolute -translate-x-1/2 text-xs font-mono text-base-content/45 whitespace-nowrap" style={ fmt.Sprintf("left: %.1f%%", xTickLeftPct(idx, len(chart.Times))) } data-iso-time={ chart.Times[idx] }></span>
						}
					}
				</div>
			</div>
		</div>

	</div>
}

func metricsFragmentURL(nodeID string) templ.SafeURL {
	values := url.Values{"fragment": {"true"}}
	if nodeID != "" {
		values.Set("node", nodeID)
	}
	return templ.SafeURL("/admin/metrics?" + values.Encode())
}

const metricsNodeSelectVals = "js:{node: this.value}"

