package pages

import (
	"fmt"
	"github.com/shepard-labs/cyclopus/internal/store"
	"github.com/shepard-labs/cyclopus/internal/ui"
	"github.com/shepard-labs/cyclopus/internal/ui/components"
)

templ AppSettings(app store.App, project store.Project, user store.User, org store.Organization, flash *ui.FlashMessage, errMsg string) {
	@components.Page("Settings — "+app.Name, user, org, flash, "/projects", appSettingsContent(app, project, errMsg))
}

templ appSettingsContent(app store.App, project store.Project, errMsg string) {
	<div class="w-full space-y-6">
		@components.Breadcrumbs([]components.BreadcrumbItem{
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name, Href: "/projects/" + project.ID},
			{Label: app.Name, Href: "/apps/" + app.ID},
			{Label: "Settings"},
		})
		if errMsg != "" {
			@components.Alert("error", errMsg)
		}
		<form method="POST" action={ templ.SafeURL("/apps/" + app.ID + "/settings") } class="space-y-6">
			@components.SectionCard("Identity") {
				<div class="grid gap-4 sm:grid-cols-2">
					@components.FormField("s-name", "name", "Name", "text", app.Name, "", true)
					<div>
						<label for="s-hostname" class="block text-xs font-medium text-base-content/80 mb-1.5">Hostname label <span class="text-error" aria-hidden="true">*</span></label>
						<input id="s-hostname" name="hostname_label" type="text" value={ app.HostnameLabel } pattern="[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?" required class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label for="s-port" class="block text-xs font-medium text-base-content/80 mb-1.5">Container port <span class="text-error" aria-hidden="true">*</span></label>
						<input id="s-port" name="container_port" type="number" value={ fmt.Sprintf("%d", app.ContainerPort) } min="1" max="65535" required class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					@components.FormField("s-health", "health_check_path", "Health check path", "text", app.HealthCheckPath, "", true)
				</div>
				@components.FormField("s-ci", "ci_workflow_id", "CI workflow ID (GitHub Actions)", "text", strptr(app.CIWorkflowID), "deploy.yml", false)
				@components.FormField("s-image-repo", "image_repository", "Image repository", "text", strptr(app.ImageRepository), "ghcr.io/org/repo", false)
			}
			@components.SectionCard("Scaling (production only)") {
				@components.Select("s-scaling", "scaling_mode", "Scaling mode", app.ScalingMode, []components.SelectOption{{Value: "hpa", Label: "HPA (default)"}, {Value: "keda_cron", Label: "KEDA cron (opt-in)"}, {Value: "keda_http", Label: "KEDA HTTP (beta, opt-in)"}}, true)
				<div class="grid gap-4 sm:grid-cols-3">
					<div>
						<label for="s-min" class="block text-xs font-medium text-base-content/80 mb-1.5">Min replicas</label>
						<input id="s-min" name="min_replicas" type="number" value={ fmt.Sprintf("%d", app.MinReplicas) } min="0" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-max" class="block text-xs font-medium text-base-content/80 mb-1.5">Max replicas</label>
						<input id="s-max" name="max_replicas" type="number" value={ fmt.Sprintf("%d", app.MaxReplicas) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-cpu-target" class="block text-xs font-medium text-base-content/80 mb-1.5">HPA CPU target %</label>
						<input id="s-cpu-target" name="hpa_target_cpu_percent" type="number" value={ fmt.Sprintf("%d", app.HPATargetCPUPercent) } min="1" max="100" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
				</div>
			}
			@components.SectionCard("Resources") {
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label for="s-cpureq" class="block text-xs font-medium text-base-content/80 mb-1.5">CPU request (millicores)</label>
						<input id="s-cpureq" name="cpu_request_millicores" type="number" value={ fmt.Sprintf("%d", app.CPURequestMillicores) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-cpulim" class="block text-xs font-medium text-base-content/80 mb-1.5">CPU limit (millicores)</label>
						<input id="s-cpulim" name="cpu_limit_millicores" type="number" value={ fmt.Sprintf("%d", app.CPULimitMillicores) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-memreq" class="block text-xs font-medium text-base-content/80 mb-1.5">Memory request (MiB)</label>
						<input id="s-memreq" name="memory_request_mib" type="number" value={ fmt.Sprintf("%d", app.MemoryRequestMiB) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-memlim" class="block text-xs font-medium text-base-content/80 mb-1.5">Memory limit (MiB)</label>
						<input id="s-memlim" name="memory_limit_mib" type="number" value={ fmt.Sprintf("%d", app.MemoryLimitMiB) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
				</div>
			}
			@components.SectionCard("Preview environments") {
				<label class="flex items-center gap-3 text-sm font-medium"><input id="s-previews" type="checkbox" name="previews_enabled" checked?={ app.PreviewsEnabled } class="size-4 rounded-field border-line bg-base-300 text-primary"/>Enable preview environments</label>
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label for="s-maxprev" class="block text-xs font-medium text-base-content/80 mb-1.5">Max previews</label>
						<input id="s-maxprev" name="max_preview_environments" type="number" value={ fmt.Sprintf("%d", app.MaxPreviewEnvironments) } min="0" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-previdlettl" class="block text-xs font-medium text-base-content/80 mb-1.5">Idle TTL (hours)</label>
						<input id="s-previdlettl" name="preview_idle_ttl_hours" type="number" value={ fmt.Sprintf("%d", app.PreviewIdleTTLHours) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
				</div>
			}
			@components.SectionCard("Deploy behavior") {
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label for="s-timeout" class="block text-xs font-medium text-base-content/80 mb-1.5">Deploy timeout (seconds)</label>
						<input id="s-timeout" name="deploy_timeout_seconds" type="number" value={ fmt.Sprintf("%d", app.DeployTimeoutSeconds) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
					<div>
						<label for="s-retention" class="block text-xs font-medium text-base-content/80 mb-1.5">Release retention count</label>
						<input id="s-retention" name="release_retention_count" type="number" value={ fmt.Sprintf("%d", app.ReleaseRetentionCount) } min="1" class="rounded-field border border-line bg-base-300 px-3 py-2 text-sm font-medium outline-none focus:border-primary focus-visible:ring-1 focus-visible:ring-primary w-full"/>
					</div>
				</div>
			}
			<div class="flex gap-3">
				@components.Button(components.ButtonProps{
					Type:    components.ButtonTypeSubmit,
					Variant: components.ButtonVariantPrimary,
				}) {
					Save settings
				}
				@components.ButtonLink(components.ButtonVariantSecondary, "/apps/" + app.ID, "Cancel")
			</div>
		</form>
	</div>
}
