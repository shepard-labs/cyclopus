# Daily trigger for cyclopus-walg-backup.service (base backups daily, §9.1;
# WAL segments stream continuously via archive_command for the 60s RPO).
# Persistent=true catches up a run missed while the node was down (a VPS
# reboot is routine, §2.3). Installed by infra/backup/configure_from_db.sh.
[Unit]
Description=Daily WAL-G base backup of Cyclopus Postgres (§9.1)

[Timer]
OnCalendar=daily
Persistent=true

[Install]
WantedBy=timers.target
